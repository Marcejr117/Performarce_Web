---
// Plantilla común: <head> con SEO, cabecera fija, <main> y pie.
import '@fontsource-variable/inter';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import escudo from '../assets/logo/escudo.png';
import { BUSINESS, PHONE, PHONE_LABEL, WHATSAPP, EMAIL, MAPS } from '../data/business';

interface Props {
  /** Título de la página; se añade " | Talleres Marcelino" salvo que ya lo lleve. */
  title: string;
  /** Descripción para buscadores y redes (unos 150 caracteres). */
  description: string;
  /** URL canónica; por defecto la de la página actual. */
  canonical?: string;
  /** Imagen para redes (ruta del sitio o URL absoluta); por defecto /og.jpg (1200x630). */
  image?: string;
  /** Excluir de buscadores (gracias, 404). */
  noindex?: boolean;
}

const { title, description, canonical, image = '/og.jpg', noindex = false } = Astro.props;

const SOCIAL = {
  youtube: 'https://www.youtube.com/@motosmarcelinomotosmarceli8261',
  facebook: 'https://www.facebook.com/profile.php?id=100063714483433',
};

const site = Astro.site ?? new URL('https://www.performarce.com');
const fullTitle = title.includes(BUSINESS) ? title : `${title} | ${BUSINESS}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

// Enlace activo: exacto para Inicio; por prefijo para el resto (Ofertas cubre /ofertas_moto, etc.)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/info', label: 'Quiénes somos' },
  { href: '/location', label: 'Ubicación' },
  { href: '/contact', label: 'Contacto' },
  { href: '/ofertas', label: 'Ofertas' },
].map((l) => ({
  ...l,
  current: (path === l.href ? 'page' : l.href !== '/' && path.startsWith(l.href) ? 'true' : undefined) as 'page' | 'true' | undefined,
}));

// Datos estructurados (sin horario: pendiente de que lo facilite el dueño)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['AutoRepair', 'Store'],
  '@id': `${site.origin}/#negocio`,
  name: BUSINESS,
  alternateName: ['Motos Marcelino', 'Performarce'],
  description:
    'Taller y tienda de motos, maquinaria de jardinería y forestal en Albacete: reparación, venta y recambios.',
  url: site.origin + '/',
  telephone: PHONE,
  email: EMAIL,
  image: new URL('/og.jpg', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. los Toreros, 22',
    postalCode: '02005',
    addressLocality: 'Albacete',
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 38.9982411, longitude: -1.8684794 },
  hasMap: MAPS,
  sameAs: [SOCIAL.youtube, SOCIAL.facebook],
};

const year = new Date().getFullYear();
const linkBase =
  'rounded-md px-3 py-2 font-medium text-ink/80 hover:text-ink dark:text-neutral-300 dark:hover:text-paper aria-[current]:text-brand-700 dark:aria-[current]:text-brand-400';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Tema antes de pintar (sin parpadeo): localStorage o preferencia del sistema -->
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const r = document.documentElement;
        r.classList.toggle('dark', t === 'dark');
        r.dataset.theme = t;
      })();
    </script>

    <meta name="theme-color" content="#E36B22" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1D20" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={BUSINESS} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {image === '/og.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/og.jpg' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`Escudo de ${BUSINESS}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="flex min-h-screen flex-col bg-paper text-ink dark:bg-ink dark:text-neutral-200">
    <a
      href="#contenido"
      class="sr-only z-50 rounded bg-brand-500 px-4 py-2 font-semibold text-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Saltar al contenido</a
    >

    <header class="sticky top-0 z-40 border-b border-paper-300 bg-paper/95 backdrop-blur dark:border-ink-700 dark:bg-ink/95">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
        <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${BUSINESS}, inicio`}>
          <span class="rounded-md bg-ink p-1 dark:bg-transparent">
            <Image src={escudo} alt="" width={44} loading="eager" class="h-10 w-auto" />
          </span>
          <span class="hidden font-display text-xl font-bold uppercase leading-none tracking-wide sm:block">
            Talleres <span class="text-brand-700 dark:text-brand-400">Marcelino</span>
          </span>
        </a>

        <nav aria-label="Principal" class="ml-auto hidden md:block">
          <ul class="flex items-center gap-1">
            {nav.map((l) => <li><a href={l.href} aria-current={l.current} class={linkBase}>{l.label}</a></li>)}
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-1 md:ml-2">
          <a
            href={`tel:${PHONE}`}
            class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-3 py-2 text-sm font-semibold text-ink hover:bg-brand-400"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
            <span class="sr-only lg:not-sr-only">Llamar {PHONE_LABEL}</span>
          </a>
          <a
            href={WHATSAPP}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Escríbenos por WhatsApp (se abre en una pestaña nueva)"
            class="hidden rounded-md p-2 text-ink/80 hover:text-ink sm:inline-flex dark:text-neutral-300 dark:hover:text-paper"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.3-.2-.5-.3Z" /></svg>
          </a>
          <button
            type="button"
            data-theme-toggle
            aria-label="Cambiar a modo oscuro"
            class="rounded-md p-2 text-ink/80 hover:text-ink dark:text-neutral-300 dark:hover:text-paper"
          >
            <!-- luna en claro, sol en oscuro -->
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <button
            type="button"
            id="menu-toggle"
            aria-controls="menu-movil"
            aria-expanded="false"
            aria-label="Abrir menú"
            class="rounded-md p-2 text-ink dark:text-paper md:hidden"
          >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="menu-open" d="M4 6h16M4 12h16M4 18h16" /><path class="menu-close hidden" d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </div>

      <nav id="menu-movil" aria-label="Principal (móvil)" class="hidden border-t border-paper-300 px-4 pb-4 pt-2 dark:border-ink-700 md:hidden">
        <ul class="flex flex-col">
          {nav.map((l) => <li><a href={l.href} aria-current={l.current} class={`block text-lg ${linkBase}`}>{l.label}</a></li>)}
          <li>
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class={`block text-lg ${linkBase}`}>
              WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <footer class="border-t-4 border-brand-500 bg-ink text-neutral-300">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
        <div>
          <a href="/" class="inline-flex items-center gap-3" aria-label={`${BUSINESS}, inicio`}>
            <Image src={escudo} alt="" width={64} class="h-16 w-auto" />
            <span class="font-display text-2xl font-bold uppercase tracking-wide text-paper">{BUSINESS}</span>
          </a>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-neutral-400">
            Performarce.com es la web oficial de {BUSINESS}: venta y reparación de motos y de maquinaria de
            jardinería y forestal en Albacete.
          </p>
        </div>

        <div>
          <h2 class="text-lg text-brand-400">Contacto</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>Teléfono: <a class="text-paper underline-offset-4 hover:underline" href={`tel:${PHONE}`}>{PHONE_LABEL}</a></li>
            <li>Email: <a class="text-paper underline-offset-4 hover:underline" href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            <li>
              Dirección:
              <a class="text-paper underline-offset-4 hover:underline" href={MAPS} target="_blank" rel="noopener noreferrer">
                Av. los Toreros, 22, 02005 Albacete<span class="sr-only"> (abre Google Maps en una pestaña nueva)</span>
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-lg text-brand-400">Síguenos</h2>
          <ul class="mt-3 flex items-center gap-2">
            <li>
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp (se abre en una pestaña nueva)" class="inline-flex rounded-md p-2 hover:bg-ink-700 hover:text-paper">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.3-.2-.5-.3Z" /></svg>
              </a>
            </li>
            <li>
              <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube (se abre en una pestaña nueva)" class="inline-flex rounded-md p-2 hover:bg-ink-700 hover:text-paper">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.5 6.5C22 8.3 22 12 22 12s0 3.7-.5 5.5a2.8 2.8 0 0 1-1.9 2C17.9 20 12 20 12 20s-5.9 0-7.6-.5a2.8 2.8 0 0 1-1.9-2C2 15.7 2 12 2 12s0-3.7.5-5.5a2.8 2.8 0 0 1 1.9-2C6.1 4 12 4 12 4s5.9 0 7.6.5a2.8 2.8 0 0 1 1.9 2ZM10 15.5l6-3.5-6-3.5v7Z" /></svg>
              </a>
            </li>
            <li>
              <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook (se abre en una pestaña nueva)" class="inline-flex rounded-md p-2 hover:bg-ink-700 hover:text-paper">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 0H2a2 2 0 0 0-2 2v20a2 2 0 0 0 2 2h11v-9h-3v-4h3V8.4c0-3.1 1.9-4.8 4.7-4.8 1.3 0 2.5.1 2.8.1v3.3h-1.9c-1.5 0-1.8.7-1.8 1.8V11h4.4l-1 4h-3.4v9H22a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Z" /></svg>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="border-t border-ink-700">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-sm text-neutral-400 sm:flex-row sm:justify-between sm:px-6">
          <p>© {year} {BUSINESS}. Todos los derechos reservados.</p>
          <a href="/privacidad" class="underline-offset-4 hover:text-paper hover:underline">Política de privacidad</a>
        </div>
      </div>
    </footer>

    <script>
      // Interruptor de tema (guarda la elección del usuario)
      const root = document.documentElement;
      const setLabel = (btn: Element) =>
        btn.setAttribute('aria-label', root.classList.contains('dark') ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        setLabel(btn);
        btn.addEventListener('click', () => {
          const theme = root.classList.toggle('dark') ? 'dark' : 'light';
          root.dataset.theme = theme;
          try { localStorage.setItem('theme', theme); } catch {}
          setLabel(btn);
        });
      });

      // Menú móvil: aria-expanded, Escape y foco
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('menu-movil');
      if (toggle && menu) {
        const setOpen = (open: boolean, focusButton = false) => {
          menu.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
          toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
          toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
          if (open) menu.querySelector('a')?.focus();
          else if (focusButton) toggle.focus();
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
        });
      }
    </script>
  </body>
</html>
