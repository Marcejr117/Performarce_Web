---
// Plantilla común: <head> con SEO y datos estructurados; cabecera, migas, <main>, pie y barra fija móvil.
import '@fontsource-variable/inter';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
// Las dos fuentes que se ven nada más cargar (mismo fichero que usan los @font-face de arriba)
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import barlowUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import Icon from '../components/Icon.astro';
import {
  BUSINESS, SITE, PHONE, EMAIL, STREET, POSTAL_CODE, CITY, GEO, MAPS, WHATSAPP, WHATSAPP_NUMBER, SOCIAL, HOURS,
} from '../data/business';

interface Props {
  /** Sin sufijo: se añade « | Talleres Marcelino» salvo que ya lo lleve. */
  title: string;
  /** 120–160 caracteres. */
  description: string;
  /** og:image (ruta del sitio o URL absoluta); por defecto /og.jpg (1200×630). */
  image?: string;
  /** Texto alternativo de la imagen para redes. */
  imageAlt?: string;
  /** 404 y gracias: robots noindex y SIN canonical. */
  noindex?: boolean;
  /** Migas sin «Inicio»; la última sin href. Se pintan y se marcan (BreadcrumbList). */
  breadcrumbs?: { name: string; href?: string }[];
  /** Nodos JSON-LD propios de la página (p. ej. Service); se añaden al @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og.jpg',
  imageAlt = 'Tienda de Talleres Marcelino en Albacete: motosierras Husqvarna y scooters en exposición',
  noindex = false,
  breadcrumbs = [],
  schema = [],
} = Astro.props;

const site = Astro.site ?? new URL(SITE);
const fullTitle = title.includes(BUSINESS) ? title : `${title} | ${BUSINESS}`;
// Con trailingSlash 'never' la ruta sale sin barra final
const pageUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

// Datos estructurados: un único @graph con la web, el negocio, las migas y lo que añada la página
const ORG = `${site.origin}/#negocio`;
const DAY = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const graph = [
  {
    '@type': 'WebSite', '@id': `${site.origin}/#web`, url: `${site.origin}/`, name: BUSINESS,
    alternateName: ['Motos Marcelino', 'Performarce'], inLanguage: 'es-ES', publisher: { '@id': ORG },
  },
  {
    '@type': ['MotorcycleRepair', 'MotorcycleDealer', 'GardenStore'], // sustituye a ['AutoRepair','Store'] (taller de COCHES)
    '@id': ORG, name: BUSINESS, alternateName: 'Motos Marcelino',
    description:
      'Taller y tienda en Albacete con más de 40 años de experiencia: reparación y venta de motos, scooters y ciclomotores, recambios y maquinaria de jardinería y forestal.',
    url: `${site.origin}/`, telephone: PHONE, email: EMAIL,
    image: new URL('/og.jpg', site).href, logo: new URL('/apple-touch-icon.png', site).href,
    address: { '@type': 'PostalAddress', streetAddress: STREET, postalCode: POSTAL_CODE, addressLocality: CITY, addressCountry: 'ES' },
    geo: { '@type': 'GeoCoordinates', latitude: GEO.lat, longitude: GEO.lng },
    hasMap: MAPS, areaServed: { '@type': 'City', name: CITY },
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', telephone: `+${WHATSAPP_NUMBER}`, url: WHATSAPP, availableLanguage: 'es' },
    brand: ['Husqvarna', 'SYM', 'Macbor', 'Benza', 'Zanon'].map((name) => ({ '@type': 'Brand', name })),
    sameAs: [SOCIAL.facebook, SOCIAL.youtube],
    ...(HOURS
      ? {
          openingHoursSpecification: HOURS.map((h) => ({
            '@type': 'OpeningHoursSpecification', dayOfWeek: h.days.map((d) => DAY[d - 1]), opens: h.opens, closes: h.closes,
          })),
        }
      : {}),
    // legalName / vatID: cuando el dueño dé razón social y NIF
  },
  ...(breadcrumbs.length
    ? [{
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Inicio', href: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem', position: i + 1, name: b.name, ...(b.href ? { item: new URL(b.href, site).href } : {}),
        })),
      }]
    : []),
  ...schema,
];
// «<» escapado: el JSON va dentro de un <script>
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const miga = 'inline-flex min-h-11 min-w-11 items-center justify-center text-sm';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Tema antes de pintar (sin parpadeo): la elección guardada o la preferencia del sistema -->
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <!-- Uno solo: la cabecera es siempre oscura -->
    <meta name="theme-color" content="#111827" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlowUrl} as="font" type="font/woff2" crossorigin />

    <!-- Redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={BUSINESS} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    {image === '/og.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/og.jpg' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body class="flex min-h-screen flex-col bg-page text-fg pb-[calc(4rem_+_env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#contenido"
      class="btn btn-primary sr-only z-[60] focus:not-sr-only focus:fixed focus:left-4 focus:top-2"
      >Saltar al contenido</a
    >

    <Header />

    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Migas de pan" class="border-b border-line">
          <ol class="wrap flex flex-wrap items-center gap-x-1.5 text-muted">
            <li>
              <a href="/" class:list={[miga, 'underline decoration-line underline-offset-4 hover:text-fg hover:decoration-current']}>
                Inicio
              </a>
            </li>
            {breadcrumbs.map((b) => (
              <li class="inline-flex items-center gap-1.5">
                <Icon name="chevron-right" class="size-4" />
                {b.href ? (
                  <a href={b.href} class:list={[miga, 'underline decoration-line underline-offset-4 hover:text-fg hover:decoration-current']}>
                    {b.name}
                  </a>
                ) : (
                  <span aria-current="page" class:list={[miga, 'font-semibold text-fg']}>
                    {b.name}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />
    <ActionBar />
  </body>
</html>
