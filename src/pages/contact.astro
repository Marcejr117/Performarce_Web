---
// Contacto: primero los canales directos (en móvil, llamar y WhatsApp a mano), después el formulario y, al lado, el mapa.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Map from '../components/Map.astro';
import Horario from '../components/Horario.astro';
import ContactActions from '../components/ContactActions.astro';
import { SITE, PHONE, PHONE_LABEL, WHATSAPP_LABEL, EMAIL, STREET, CITY, SOCIAL, waLink } from '../data/business';

const NUEVA = ' (se abre en una pestaña nueva)';

// Tarjetas de canales: la tarjeta entera es el enlace. Icono a la izquierda en móvil y en lg (tarjetas anchas);
// encima en sm–md y desde xl (tarjetas estrechas), para que el email y la dirección quepan.
const CANALES = [
  { etiqueta: 'Teléfono', icono: 'phone', valor: PHONE_LABEL, accion: 'Llamar', href: `tel:${PHONE}`, externo: false },
  { etiqueta: 'WhatsApp', icono: 'brand-whatsapp', valor: WHATSAPP_LABEL, accion: 'Escribir por WhatsApp', href: waLink(), externo: true },
  { etiqueta: 'Email', icono: 'mail', valor: EMAIL, accion: 'Enviar un email', href: `mailto:${EMAIL}`, externo: false },
  { etiqueta: 'Visítanos', icono: 'map-pin', valor: `${STREET}, ${CITY}`, accion: 'Ver cómo llegar', href: '/location', externo: false },
] as const;

const MOTIVOS = [
  'Reparación de moto o scooter',
  'Reparación de maquinaria de jardín o forestal',
  'Recambios',
  'Comprar moto o scooter',
  'Comprar maquinaria de jardín o forestal',
  'Ofertas y folletos',
  'Otra consulta',
];

// Campos: borde `field` (≥ 3:1 en los dos temas) y 48 px de alto
const campo = 'block min-h-12 w-full rounded-lg border border-field bg-raised px-4 text-fg placeholder:text-muted';
const etiqueta = 'mb-1.5 block font-semibold';
// Números, espacios y «+». Hasta 20 caracteres para que quepa «+34 600 12 34 56» con espacios.
const PATRON_TEL = '[+0-9 ]{9,20}';
---

<Layout
  title="Contacto: teléfono, WhatsApp y email"
  description={`Llámanos al ${PHONE_LABEL}, escríbenos por WhatsApp al ${WHATSAPP_LABEL} o a ${EMAIL}. Estamos en ${STREET}, ${CITY}.`}
  breadcrumbs={[{ name: 'Contacto' }]}
>
  <PageHeader
    eyebrow="Hablemos"
    title="Contacto"
    lead={`Llámanos, escríbenos por WhatsApp o pásate por la tienda en ${STREET} (${CITY}). Si lo prefieres, déjanos tu consulta en el formulario.`}
  />

  <!-- Canales: lo primero de la página, también en móvil (antes del formulario) -->
  <section aria-labelledby="canales" class="py-8 md:py-12">
    <div class="wrap">
      <h2 id="canales" class="sr-only">Canales de contacto</h2>
      <ul class="grid gap-4 sm:grid-cols-2 sm:gap-6 xl:grid-cols-4 xl:gap-8">
        {
          CANALES.map((c) => (
            <li>
              <a
                href={c.href}
                class="box box-hover group flex h-full gap-4 p-5 sm:flex-col lg:flex-row xl:flex-col"
                {...(c.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="ico-chip">
                  <Icon name={c.icono} />
                </span>
                <span class="flex min-w-0 grow flex-col">
                  <span class="text-[0.8125rem] font-semibold uppercase tracking-[0.08em] text-muted">{c.etiqueta}</span>
                  <span class="mt-1 font-display text-[1.75rem] font-semibold leading-[1.1] tabular-nums text-fg">
                    {/* Posible corte tras la arroba, para que el email quepa en las tarjetas estrechas */}
                    {c.valor.split('@').map((parte, i) => (i ? <Fragment>@<wbr />{parte}</Fragment> : parte))}
                  </span>
                  <span class="mt-auto inline-flex items-center gap-1.5 pt-3 font-semibold text-link group-hover:underline">
                    {c.accion}
                    <Icon name="arrow-right" class="size-5" />
                  </span>
                </span>
                {c.externo && <span class="sr-only">{NUEVA}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="formulario" class="section border-t border-line bg-surface">
    <div class="wrap grid items-start gap-10 lg:grid-cols-[3fr_2fr] lg:gap-12">
      <form
        action={`https://formsubmit.co/${EMAIL}`}
        method="POST"
        aria-labelledby="escribenos"
        data-contacto
        class="box p-6 sm:p-8"
      >
        <h2 id="escribenos">Escríbenos</h2>

        <div class="mt-6 space-y-5">
          <div>
            <label for="nombre" class={etiqueta}>Nombre</label>
            <input id="nombre" name="Nombre" type="text" required autocomplete="name" class={campo} />
          </div>

          <div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="telefono" class={etiqueta}>Teléfono</label>
                <input
                  id="telefono"
                  name="Telefono"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  pattern={PATRON_TEL}
                  title="Solo números, espacios y el signo +"
                  aria-describedby="nota-respuesta"
                  class={campo}
                />
              </div>
              <div>
                <label for="email" class={etiqueta}>Email</label>
                <input id="email" name="email" type="email" autocomplete="email" aria-describedby="nota-respuesta" class={campo} />
              </div>
            </div>
            <p id="nota-respuesta" class="mt-2 text-[0.9375rem] text-muted">
              Déjanos al menos un teléfono o un email para responderte.
            </p>
          </div>

          <div>
            <label for="motivo" class={etiqueta}>¿Qué necesitas? <span class="font-normal text-muted">(opcional)</span></label>
            <select id="motivo" name="Motivo" class={campo}>
              <option value="">Elige una opción</option>
              {MOTIVOS.map((m) => <option>{m}</option>)}
            </select>
          </div>

          <div>
            <label for="mensaje" class={etiqueta}>Mensaje</label>
            <textarea
              id="mensaje"
              name="Mensaje"
              required
              minlength="10"
              rows="5"
              placeholder="Marca, modelo y qué le pasa, o qué estás buscando…"
              class:list={[campo, 'py-3']}></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input
              id="consentimiento"
              name="Acepta_privacidad"
              type="checkbox"
              value="Sí"
              required
              class="checkbox checkbox-primary mt-0.5 border-field"
            />
            <!-- La <label> va dentro de un <p>: el enlace es parte de la frase (excepción de tamaño táctil para enlaces en texto) -->
            <p class="text-[0.9375rem]">
              <label for="consentimiento">
                He leído la <a href="/privacidad" target="_blank" rel="noopener noreferrer" class="lnk"
                  >política de privacidad<span class="sr-only">{NUEVA}</span></a
                > y acepto que uséis mis datos para responder a este mensaje.
              </label>
            </p>
          </div>
        </div>

        <!-- Campo trampa: las personas no lo ven; si llega relleno, FormSubmit descarta el envío -->
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <input type="hidden" name="_subject" value="Nueva consulta desde performarce.com" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={`${SITE}/gracias`} />
        <input type="hidden" name="_captcha" value="false" />

        <button type="submit" class="btn btn-primary mt-8 w-full sm:w-auto">
          Enviar consulta
          <Icon name="arrow-right" class="size-5" />
        </button>
      </form>

      <div class="space-y-6 lg:pt-8">
        <h2>Dónde estamos</h2>
        <Horario />
        <Map ratio="aspect-[4/3] md:aspect-[16/10] lg:aspect-[4/3]" />
        <ContactActions actions={['directions']} primary={null} />
        <ul aria-label="Redes sociales" class="flex flex-wrap gap-x-6 border-t border-line pt-4">
          <li>
            <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" class="lnk inline-flex min-h-11 items-center gap-2">
              <Icon name="brand-facebook" class="size-5" />Facebook<span class="sr-only">{NUEVA}</span>
            </a>
          </li>
          <li>
            <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" class="lnk inline-flex min-h-11 items-center gap-2">
              <Icon name="brand-youtube" class="size-5" />YouTube<span class="sr-only">{NUEVA}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    // Teléfono o email: al menos uno. Si faltan los dos, el navegador muestra este error en el teléfono y no envía.
    const form = document.querySelector<HTMLFormElement>('[data-contacto]');
    const tel = form?.querySelector<HTMLInputElement>('[name="Telefono"]');
    const email = form?.querySelector<HTMLInputElement>('[name="email"]');
    if (form && tel && email) {
      const comprobar = () =>
        tel.setCustomValidity(tel.value.trim() || email.value.trim() ? '' : 'Escribe un teléfono o un email para poder responderte.');
      comprobar();
      form.addEventListener('input', comprobar);
    }
  </script>
</Layout>
