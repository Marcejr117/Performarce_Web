---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import tienda from '../assets/info/com_ven.jpg';
import herramientas from '../assets/info/servicio.jpg';
import fachada from '../assets/info/taller.png';

// Iconos de trazo (estilo Tabler) en línea; cada bloque alterna el lado de la foto.
const blocks = [
  {
    id: 'compra-venta',
    title: 'Compra y venta',
    text: [
      'Vendemos productos nuevos y de segunda mano. Los usados pasan siempre una revisión antes de salir de la tienda.',
      'Trabajamos con marcas de calidad, tanto en motos como en jardín y forestal, y siempre al mejor precio.',
    ],
    image: tienda,
    alt: 'Interior de la tienda: motosierras Husqvarna colgadas en la pared y scooters nuevos en exposición',
    icon: 'M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572M12 6l-3.293 3.293a1 1 0 0 0 0 1.414l.543 .543c.69 .69 1.81 .69 2.5 0l1 -1a3.182 3.182 0 0 1 4.5 0l2.25 2.25M12.5 15.5l2 2M15 13l2 2',
  },
  {
    id: 'servicio',
    title: 'Servicio',
    text: [
      'En el taller tenemos especialistas en cada campo. Si tienes cualquier duda sobre motos, scooters, jardinería o forestal, te la resolvemos.',
      'Para nosotros el cliente es lo primero, y por eso cuidamos el trato tanto como la reparación.',
    ],
    image: herramientas,
    alt: 'Juego de llaves fijas y de tubo ordenadas en el panel de herramientas del taller',
    icon: 'M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2M16 3.13a4 4 0 0 1 0 7.75M21 21v-2a4 4 0 0 0 -3 -3.85',
  },
  {
    id: 'historia',
    title: 'Historia',
    text: [
      'Talleres Marcelino lleva más de 40 años contigo en Albacete, reparando y vendiendo motos y maquinaria de jardín y forestal.',
      'En todo este tiempo nuestro objetivo ha sido el mismo: un servicio de calidad, a buen precio, con el que salgas satisfecho.',
    ],
    image: fachada,
    alt: 'Fachada de Talleres Marcelino en la Avenida de los Toreros, con toldos rojos y motos aparcadas en la acera',
    icon: 'M3 4m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2zM5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-10M10 12l4 0',
  },
];
---

<Layout
  title="Quiénes somos"
  description="Compra y venta de motos y maquinaria de jardín y forestal, servicio técnico y más de 40 años de experiencia en Albacete."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <p class="font-semibold uppercase tracking-widest text-brand-700 dark:text-brand-400">Información</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Quiénes somos</h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-700 dark:text-neutral-300">
      Somos un taller de Albacete dedicado a dos mundos: las motos y la maquinaria de jardín y forestal.
      Vendemos, reparamos y te aconsejamos.
    </p>

    <div class="mt-12 space-y-16 sm:space-y-24">
      {blocks.map((b, i) => (
        <article id={b.id} class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
          <Image
            src={b.image}
            alt={b.alt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            class={`aspect-[4/3] w-full rounded-lg object-cover shadow-lg ${i % 2 ? 'md:order-2' : ''}`}
          />
          <div>
            <svg aria-hidden="true" class="h-12 w-12 text-brand-700 dark:text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={b.icon} />
            </svg>
            <h2 class="mt-3 text-3xl sm:text-4xl">{b.title}</h2>
            {b.text.map((p) => <p class="mt-4 text-neutral-700 dark:text-neutral-300">{p}</p>)}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-start gap-4 rounded-lg bg-ink p-8 text-paper dark:bg-ink-800 dark:ring-1 dark:ring-ink-700 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-2xl font-bold uppercase tracking-wide">¿Hablamos?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-primary">Escríbenos</a>
        <a href="tel:+34967226001" class="btn btn-outline border-paper text-paper hover:border-paper hover:bg-paper hover:text-ink">Llamar</a>
      </div>
    </div>
  </section>
</Layout>
