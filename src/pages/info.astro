---
// Quiénes somos (§4.9): compra y venta, servicio e historia (zigzag) y enlaces a las tres páginas de servicio.
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Enlaces from '../components/servicios/Enlaces.astro';
import tienda from '../assets/fotos/tienda-motos-motosierras-husqvarna-albacete.jpg';
import herramientas from '../assets/fotos/taller-herramientas.jpg';
import escudo from '../assets/logo/escudo.png';

// Cada bloque alterna el lado de la foto. «Historia» lleva el panel oscuro del escudo en lugar de foto.
const BLOQUES: {
  id: string;
  icon: ComponentProps<typeof Icon>['name'];
  title: string;
  text: string[];
  /** framing: encuadre (scale-*, origin-*); sizes: anchos ya multiplicados por esa ampliación. */
  image?: { src: ImageMetadata; alt: string; framing?: string; sizes?: string };
}[] = [
  {
    id: 'compra-venta',
    icon: 'building-store',
    title: 'Compra y venta',
    text: [
      'Vendemos productos nuevos y de segunda mano. Los usados pasan siempre una revisión antes de salir de la tienda.',
      'Trabajamos con marcas de calidad, tanto en motos como en jardín y forestal, y siempre al mejor precio.',
    ],
    image: {
      src: tienda,
      alt: 'Interior de la tienda: motosierras Husqvarna colgadas en la pared y scooters nuevos en exposición',
      // Ampliada hacia abajo a la izquierda (como el héroe de la portada) para dejar fuera los trazos pintados de la
      // esquina superior derecha del original: se ve x 0–67 % e y 27–93 % de la foto.
      // ponytail: en móvil, 100vw y no 150vw porque es la imagen LCP; en pantallas de 3x se ve algo blanda.
      // Si molesta, 150vw (unos 85 KB más en móvil).
      framing: 'scale-150 origin-[0%_80%]',
      sizes: '(min-width: 768px) 75vw, 100vw',
    },
  },
  {
    id: 'servicio',
    icon: 'tool',
    title: 'Servicio',
    text: [
      'En el taller tenemos especialistas en cada campo. Si tienes cualquier duda sobre motos, scooters, jardinería o forestal, te la resolvemos.',
      'Para nosotros el cliente es lo primero, y por eso cuidamos el trato tanto como la reparación.',
    ],
    image: { src: herramientas, alt: 'Juego de llaves fijas y de tubo ordenadas en el panel de herramientas del taller' },
  },
  {
    id: 'historia',
    icon: 'award',
    title: 'Historia',
    text: [
      'Talleres Marcelino lleva más de 40 años contigo en Albacete, reparando y vendiendo motos y maquinaria de jardín y forestal.',
      'En todo este tiempo nuestro objetivo ha sido el mismo: un servicio de calidad, a buen precio, con el que salgas satisfecho.',
    ],
  },
];
---

<Layout
  title="Quiénes somos: +40 años en Albacete"
  description="Taller y tienda de Albacete con más de 40 años de experiencia en motos y maquinaria de jardín y forestal: compra y venta, servicio técnico e historia."
  breadcrumbs={[{ name: 'Quiénes somos' }]}
>
  <PageHeader
    eyebrow="Taller y tienda en Albacete"
    title="Quiénes somos"
    lead="Somos un taller de Albacete dedicado a dos mundos: las motos y la maquinaria de jardín y forestal. Vendemos, reparamos y te aconsejamos."
  />

  <div class="section">
    <div class="wrap space-y-16 md:space-y-24">
      {
        BLOQUES.map((b, i) => (
          <section id={b.id} aria-labelledby={`${b.id}-titulo`} class="grid items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
            {b.image ? (
              <div class:list={['aspect-[4/3] overflow-hidden rounded-2xl', i % 2 === 1 && 'md:order-2']}>
                {/* AVIF: la primera es la imagen principal (LCP) */}
                <Picture
                  src={b.image.src}
                  formats={['avif', 'webp']}
                  alt={b.image.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes={b.image.sizes ?? '(min-width: 768px) 50vw, 100vw'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  class:list={['h-full w-full object-cover', b.image.framing]}
                />
              </div>
            ) : (
              <div
                data-theme="dark"
                class:list={[
                  'flex aspect-[4/3] w-full flex-col items-center justify-center gap-4 rounded-2xl border border-line bg-surface p-6',
                  i % 2 === 1 && 'md:order-2',
                ]}
              >
                {/* Anchos según el alto mostrado (112/160/192 px): en móvil no hace falta el de 384 px */}
                <Image
                  src={escudo}
                  alt="Escudo de Talleres Marcelino"
                  height={384}
                  widths={[200, 366]}
                  sizes="(min-width: 1024px) 183px, (min-width: 640px) 153px, 107px"
                  class="h-28 w-auto sm:h-40 lg:h-48"
                />
                <p class="font-display text-[4rem] font-bold uppercase leading-none text-fg">
                  <span class="text-brand">+40</span> años
                </p>
              </div>
            )}
            <div>
              <span class="ico-chip">
                <Icon name={b.icon} class="size-6" />
              </span>
              <h2 id={`${b.id}-titulo`} class="mt-4">{b.title}</h2>
              <div class="mt-4 max-w-measure space-y-4">
                {b.text.map((p) => <p>{p}</p>)}
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  {/* Sin bg-surface: en oscuro se fundía con CtaBand (también surface). La línea la separa del zigzag. */}
  <section class="section border-t border-line" aria-labelledby="lo-que-hacemos">
    <div class="wrap">
      <SectionHeading eyebrow="Servicios" title="Lo que hacemos" id="lo-que-hacemos" />
      <Enlaces
        class="mt-8 md:mt-10 lg:grid-cols-3"
        links={[
          { href: '/taller-de-motos', icon: 'tool', title: 'Taller de motos' },
          { href: '/tienda-de-motos', icon: 'motorbike', title: 'Motos, scooters y recambios' },
          { href: '/jardin-y-forestal', icon: 'plant-2', title: 'Maquinaria de jardín y forestal' },
        ]}
      />
    </div>
  </section>

  <CtaBand />
</Layout>
