---
// Tras enviar el formulario (FormSubmit redirige aquí con _next). noindex, sin canonical y fuera del sitemap.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactActions from '../components/ContactActions.astro';
---

<Layout
  noindex
  title="Mensaje enviado"
  description="Hemos recibido tu mensaje. Te responderemos lo antes posible."
  breadcrumbs={[{ name: 'Contacto', href: '/contact' }, { name: 'Mensaje enviado' }]}
>
  <PageHeader
    eyebrow="Contacto"
    title="¡Gracias por escribirnos!"
    lead="Hemos recibido tu mensaje y te responderemos lo antes posible por teléfono o por email. Si es urgente, llámanos o escríbenos por WhatsApp."
  >
    <!-- En móvil, un botón por fila a todo el ancho; en escritorio, juntos -->
    <ContactActions full class="max-w-md" />
    <a href="/" class="lnk mt-6 inline-flex min-h-11 items-center">Volver al inicio</a>
  </PageHeader>
</Layout>
