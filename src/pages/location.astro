---
// Ubicación: «Dónde estamos» con el mapa de Google a todo el ancho, como en la web original. Debajo, la dirección y
// los botones de ruta (HTML propio: se ven aunque el mapa no cargue).
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Map from '../components/Map.astro';
import Horario from '../components/Horario.astro';
import { BUSINESS, ADDRESS, STREET, POSTAL_CODE, CITY, PHONE_LABEL, DIRECTIONS } from '../data/business';

const RUTAS = [
  { href: DIRECTIONS.google, icono: 'route', texto: 'Cómo llegar con Google Maps', estilo: 'btn-primary' },
  { href: DIRECTIONS.apple, icono: 'map-2', texto: 'Apple Maps', estilo: 'btn-outline' },
  { href: DIRECTIONS.waze, icono: 'navigation', texto: 'Waze', estilo: 'btn-outline' },
] as const;
---

<Layout
  title={`Ubicación: ${STREET}, ${CITY}`}
  description={`${BUSINESS} está en ${ADDRESS}. Abre la ruta en Google Maps, llámanos al ${PHONE_LABEL} o escríbenos por WhatsApp.`}
  breadcrumbs={[{ name: 'Ubicación' }]}
>
  <section class="section pt-8 md:pt-12">
    <div class="wrap">
      <p class="eyebrow">Ubicación</p>
      <h1 class="mt-3">Dónde estamos</h1>
      {/* Sin la dirección en el pie del mapa: va debajo, en grande */}
      <Map ratio="h-[24rem] sm:h-[26rem] lg:h-[29rem]" address={false} class="mt-6 md:mt-8" />

      <div class="mt-8 flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
        <div>
          <h2 class="eyebrow font-sans">Dirección</h2>
          <address class="mt-2 font-display text-[1.75rem] font-semibold not-italic leading-[1.1] text-fg">
            {STREET}, {POSTAL_CODE} {CITY}
          </address>
        </div>
        <div class="flex flex-wrap gap-3 max-sm:w-full">
          {
            RUTAS.map((r) => (
              <a href={r.href} target="_blank" rel="noopener noreferrer" class:list={['btn max-sm:w-full', r.estilo]}>
                <Icon name={r.icono} class="size-5" />
                {r.texto}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            ))
          }
        </div>
      </div>
      <Horario class="mt-8" />
    </div>
  </section>

  <div class="border-t border-line bg-surface">
    <p class="wrap py-8">
      ¿Prefieres escribirnos? <a href="/contact#formulario" class="lnk">Ve al formulario de contacto</a>
    </p>
  </div>
</Layout>
