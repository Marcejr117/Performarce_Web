---
// Portada de ofertas: elige entre las dos líneas de negocio.
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import fotoMoto from "../assets/fondos/oferta_moto.jpeg";
import fotoForestal from "../assets/fondos/oferta_forestal.jpg";

const lineas = [
    {
        href: "/ofertas_moto",
        titulo: "Motos y Complementos",
        texto: "Motos, scooters, recambios y equipamiento",
        foto: fotoMoto,
        // Corte diagonal (firma de la marca) solo en escritorio, donde las mitades van en paralelo
        clip: "md:clip-diagonal-r",
    },
    {
        href: "/ofertas_forestal",
        titulo: "Jardinería y Forestal",
        texto: "Maquinaria de jardín y forestal",
        foto: fotoForestal,
        clip: "md:clip-diagonal-l",
    },
];
---

<Layout
    title="Ofertas"
    description="Ofertas y folletos de motos y complementos, y de maquinaria de jardinería y forestal en Talleres Marcelino, Albacete."
>
    <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
        <h1 class="text-4xl text-ink dark:text-paper sm:text-5xl">Ofertas</h1>
        <p class="mt-2 max-w-2xl text-neutral-600 dark:text-neutral-400">
            Elige la sección y consulta los folletos vigentes. Puedes verlos en
            el navegador o descargarlos.
        </p>
    </section>

    <!-- El fondo oscuro asoma entre los dos cortes y forma una franja diagonal -->
    <div class="mt-8 flex flex-col gap-1 bg-ink md:h-[60vh] md:min-h-[24rem] md:flex-row md:gap-0">
        {
            lineas.map((l) => (
                <a
                    href={l.href}
                    class={`group relative isolate flex h-64 items-end overflow-hidden focus-visible:outline focus-visible:outline-4 focus-visible:-outline-offset-4 focus-visible:outline-brand-500 sm:h-80 md:h-full md:flex-1 ${l.clip}`}
                >
                    <Image
                        src={l.foto}
                        alt=""
                        widths={[640, 960, 1400]}
                        sizes="(min-width:768px) 50vw, 100vw"
                        loading="eager"
                        class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
                    />
                    {/* Velo uniforme para calmar la foto; el contraste AA lo garantiza la caja sólida (bg-ink) del texto */}
                    <span class="absolute inset-0 -z-10 bg-ink/30 transition-colors group-hover:bg-ink/10" aria-hidden="true" />
                    <div class="m-6 bg-ink px-5 py-4 text-paper md:mb-12 md:ml-12">
                        <h2 class="text-3xl sm:text-4xl">{l.titulo}</h2>
                        <span class="mt-1 block text-sm text-neutral-200">{l.texto}</span>
                        <span class="mt-3 inline-flex items-center gap-2 font-semibold text-brand-400 underline-offset-4 group-hover:underline">
                            Ver ofertas
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </span>
                    </div>
                </a>
            ))
        }
    </div>
</Layout>
