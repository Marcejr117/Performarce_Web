---
// Ofertas: todos los folletos, agrupados por categoría (los PDF se leen de la carpeta en el build).
// Sin ninguno: invitación a preguntar. Siempre, enlaces a las dos líneas de la tienda (páginas de servicio).
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import ConFlecha from '../components/ConFlecha.astro';
import FiltroCategorias from '../components/ofertas/FiltroCategorias.astro';
import ListaFolletos from '../components/ofertas/ListaFolletos.astro';
import OfertasVacio from '../components/ofertas/OfertasVacio.astro';
import AyudaOfertas from '../components/ofertas/AyudaOfertas.astro';
import { waLink } from '../data/business';
import { CATEGORIAS, getFolletos } from '../lib/ofertas';

const moto = getFolletos('moto');
const forestal = getFolletos('forestal');
const total = moto.length + forestal.length;
// Primero las categorías con folletos, para no abrir la página con una vacía (sort es estable: si no, motos y forestal)
const grupos = [
  { cat: 'moto' as const, folletos: moto },
  { cat: 'forestal' as const, folletos: forestal },
].sort((a, b) => Number(b.folletos.length > 0) - Number(a.folletos.length > 0));
// Las dos primeras carátulas de la página cargan sin esperar
const eager = [2, Math.max(0, 2 - grupos[0].folletos.length)];
// Sin ningún folleto, la cabecera va sin las píldoras de categorías: no hay nada que filtrar
const cabecera = {
  eyebrow: 'Ofertas',
  title: 'Ofertas y folletos',
  lead: total
    ? 'Folletos y promociones vigentes de motos, scooters y maquinaria de jardín y forestal. Ábrelos en el navegador, descárgalos o pregúntanos por WhatsApp.'
    : 'Aquí publicamos los folletos de temporada de nuestras marcas de motos y de jardín y forestal.',
  tone: total ? 'surface' : 'page',
} as const;
const lineas = [
  {
    href: CATEGORIAS.moto.servicio,
    titulo: 'Motos, scooters y recambios',
    texto: 'Motos, scooters y ciclomotores nuevos y de ocasión, cascos, accesorios y recambios.',
    icono: 'motorbike',
  },
  {
    href: CATEGORIAS.forestal.servicio,
    titulo: 'Maquinaria de jardín y forestal',
    texto: 'Cortacéspedes, robots, motosierras, desbrozadoras y maquinaria forestal. Venta, reparación y puesta a punto.',
    icono: 'plant-2',
  },
] as const;
---

<Layout
  title="Ofertas y folletos en Albacete"
  description="Folletos y promociones vigentes de motos, scooters y maquinaria de jardín y forestal en Talleres Marcelino (Albacete). Consúltalos o descárgalos."
  breadcrumbs={[{ name: 'Ofertas' }]}
>
  {
    total > 0 ? (
      <PageHeader {...cabecera}>
        <FiltroCategorias actual="todas" />
      </PageHeader>
    ) : (
      <PageHeader {...cabecera} />
    )
  }

  {
    total === 0 ? (
      <OfertasVacio />
    ) : (
      <div class="divide-y divide-line">
        {grupos.map((g, i) => {
          const { nombre, ruta, whatsapp } = CATEGORIAS[g.cat];
          const n = g.folletos.length;
          return (
            <section class="section" aria-labelledby={`titulo-${g.cat}`}>
              <div class="wrap">
                {n > 0 ? (
                  <SectionHeading title={nombre} id={`titulo-${g.cat}`}>
                    <span class="ml-2 align-middle font-sans text-base font-normal normal-case tracking-normal text-muted">
                      ({n} {n === 1 ? 'folleto' : 'folletos'})
                    </span>
                    <a slot="aside" href={ruta} class="lnk inline-flex min-h-11 items-center gap-2">
                      Ver solo {nombre.toLowerCase()}
                      <Icon name="arrow-right" class="size-5" />
                    </a>
                  </SectionHeading>
                ) : (
                  <SectionHeading title={nombre} id={`titulo-${g.cat}`} />
                )}
                {n > 0 ? (
                  <ListaFolletos folletos={g.folletos} destacar={false} eager={eager[i]} class="mt-8 md:mt-10" />
                ) : (
                  <p class="mt-6 rounded-xl border-2 border-dashed border-line px-5 py-4">
                    Ahora no hay folletos de {nombre.toLowerCase()}.{' '}
                    <a class="lnk" href={waLink(whatsapp)} target="_blank" rel="noopener noreferrer">
                      Pregúntanos por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
                    </a>
                  </p>
                )}
              </div>
            </section>
          );
        })}
      </div>
    )
  }

  {/* Las dos líneas de la tienda (§5.4: la página general enlaza los servicios), con folletos o sin ellos */}
  <section class:list={['section', total > 0 && 'border-t border-line']} aria-labelledby="tienda">
    <div class="wrap">
      <SectionHeading id="tienda" title="Qué encontrarás en la tienda" />
      <ul role="list" class="mt-8 grid gap-4 sm:gap-6 md:mt-10 md:grid-cols-2 lg:gap-8">
        {
          lineas.map((l) => (
            <li>
              {/* En el móvil, el icono encima y la flecha tras el título: el texto usa todo el ancho (en tres columnas
                  se quedaba en unos 200 px y 5–6 líneas) */}
              <a href={l.href} class="box box-hover flex h-full items-start gap-4 p-5 max-sm:flex-col sm:p-6">
                <span class="ico-chip">
                  <Icon name={l.icono} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-2xl font-semibold leading-tight text-fg">
                    <ConFlecha texto={l.titulo} class="text-link sm:hidden" />
                  </span>
                  <span class="mt-1 block text-muted">{l.texto}</span>
                </span>
                <Icon name="arrow-right" class="mt-1 size-6 text-link max-sm:hidden" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Sin folletos no va (desviación de §4.2.4): OfertasVacio ya lleva WhatsApp y Llamar, y saldrían repetidos */}
  {total > 0 && <AyudaOfertas whatsappText="Hola, ¿qué ofertas tenéis ahora?" />}
</Layout>
