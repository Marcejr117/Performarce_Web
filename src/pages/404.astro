---
import Layout from '../layouts/Layout.astro';
---

<Layout noindex title="Página no encontrada" description="La página que buscas no existe o ha cambiado de dirección.">
  <section class="mx-auto max-w-2xl px-4 py-20 text-center sm:py-28">
    <p class="font-display text-8xl font-bold text-brand-700 dark:text-brand-400" aria-hidden="true">404</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Aquí no hay nada</h1>
    <p class="mt-4 text-lg text-neutral-700 dark:text-neutral-300">
      La página que buscas no existe o ha cambiado de dirección. Prueba desde el inicio o pregúntanos directamente.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/ofertas" class="btn btn-outline">Ver ofertas</a>
      <a href="/contact" class="btn btn-outline">Contacto</a>
    </div>
  </section>
</Layout>
