---
// Portada: héroe con las fotos de la web original (cambian solas), qué hacemos, ofertas, marcas y el mapa a todo el ancho.
// Sin bloques de contacto repetidos: Llamar y WhatsApp solo en el héroe y, en móvil, en la barra fija de abajo.
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactActions from '../components/ContactActions.astro';
import Horario from '../components/Horario.astro';
import Map from '../components/Map.astro';
import LogoGrid from '../components/LogoGrid.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ConFlecha from '../components/ConFlecha.astro';

import rider from '../assets/fotos/husqvarna-rider-cortacesped.jpg';
import motosierra from '../assets/fotos/husqvarna-motosierra-forestal.jpg';
import robot from '../assets/fotos/husqvarna-automower-robot-cortacesped.jpg';
import taller from '../assets/fotos/taller-herramientas.jpg';
import scooters from '../assets/fotos/tienda-scooters.jpg';
import motosierras from '../assets/fotos/tienda-motosierras-husqvarna.jpg';
import ofertasMotos from '../assets/fotos/ofertas-motos.jpg';
import ofertasForestal from '../assets/fotos/ofertas-jardin-forestal.jpg';

import { PHONE_LABEL } from '../data/business';
import { DESTACADAS_MOTO, DESTACADAS_FORESTAL, MARCAS_MOTO, MARCAS_FORESTAL } from '../data/marcas';
import { CATEGORIAS, getFolletos } from '../lib/ofertas';

// Las tres fotos del héroe de la web original. `pos`: encuadre para que lo importante quede fuera del fundido de la
// izquierda (desde lg) y no se corte: el conductor, el leñador y el robot
const FOTOS = [
  { src: rider, alt: 'Cortacésped con conductor Husqvarna en un jardín', pos: 'object-[40%_50%]' },
  { src: motosierra, alt: 'Motosierra Husqvarna talando un árbol en el bosque', pos: 'object-[0%_50%]' },
  { src: robot, alt: 'Robot cortacésped Husqvarna Automower junto a un seto', pos: 'object-[80%_50%]' },
];

const SERVICIOS = [
  {
    palabra: 'Taller', foto: taller, href: '/taller-de-motos', enlace: 'Ver el taller',
    texto: 'Reparación y mantenimiento de motos, scooters y ciclomotores.',
  },
  {
    palabra: 'Motos', foto: scooters, href: '/tienda-de-motos', enlace: 'Ver motos y scooters',
    texto: 'Motos, scooters y ciclomotores, cascos, accesorios y recambios.',
  },
  {
    palabra: 'Jardín y forestal', foto: motosierras, href: '/jardin-y-forestal', enlace: 'Ver jardín y forestal',
    texto: 'Motosierras, desbrozadoras, cortacéspedes y robots. Venta y reparación.',
  },
];

// Ofertas: las dos categorías con las fotos de la página de ofertas de la web original
const OFERTAS = [
  { ...CATEGORIAS.moto, titulo: 'Motos y complementos', foto: ofertasMotos, n: getFolletos('moto').length },
  { ...CATEGORIAS.forestal, titulo: 'Jardinería y forestal', foto: ofertasForestal, n: getFolletos('forestal').length },
];
---

<Layout
  title="Talleres Marcelino: motos, jardín y forestal en Albacete"
  description={`Más de 40 años en Albacete: taller y venta de motos y scooters, recambios y maquinaria de jardín y forestal. Llámanos al ${PHONE_LABEL}.`}
>
  <!-- 1. Héroe, siempre oscuro, como el de la web original: texto a la izquierda y fotos a la derecha, fundidas con el
       fondo en diagonal. Móvil y tablet: fotos arriba, fundidas por abajo, y texto debajo. -->
  <section data-theme="dark" class="relative flex flex-col bg-page lg:min-h-[34rem] lg:justify-center">
    <div class="wrap pb-12 pt-8 sm:pt-10 lg:py-16">
      {/* Por encima de las fotos: desde lg su caja (55 %) pisa el final de esta columna, en la parte opaca del fundido */}
      <div class="relative z-10 lg:w-1/2 lg:pr-12">
        <p class="eyebrow">Talleres Marcelino · Albacete</p>
        <h1 class="mt-3">
          <span class="text-brand">Motos</span>, <span class="text-brand">jardinería</span> y
          <span class="text-brand">forestal</span> en Albacete
        </h1>
        <p class="lead mt-5">
          Más de 40 años reparando y vendiendo motos, scooters y maquinaria de jardín y forestal, con taller propio y
          recambios.
        </p>
        {/* En móvil no: la barra fija de abajo ya tiene Llamar, WhatsApp y Cómo llegar */}
        <ContactActions class="mt-8 max-md:hidden" />
      </div>
    </div>
    <div
      data-carrusel
      class="relative order-first aspect-[2/1] overflow-hidden sm:aspect-[5/2] lg:absolute lg:inset-y-0 lg:right-0 lg:order-none lg:aspect-auto lg:w-[55%]"
    >
      {
        FOTOS.map((f, i) => (
          <Picture
            src={f.src}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1470]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            quality={40}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            alt={f.alt}
            data-foto
            class:list={[
              'absolute inset-0 h-full w-full object-cover transition-opacity duration-1000',
              f.pos,
              i > 0 && 'hidden opacity-0', // las otras dos se cargan después de la página (script)
            ]}
          />
        ))
      }
      <div class="hero-fundido pointer-events-none absolute inset-0" aria-hidden="true"></div>
      {/* Las fotos cambian solas: botón para pararlas (WCAG 2.2.2) */}
      <button
        type="button"
        data-pausa
        class="absolute bottom-3 right-3 grid size-11 place-items-center rounded-full bg-page/75 text-fg backdrop-blur-sm transition-colors hover:bg-page"
        aria-label="Pausar las fotos"
      >
        <Icon name="player-pause" class="size-5" />
        <Icon name="player-play" class="hidden size-5" />
      </button>
    </div>
  </section>

  <!-- 2. Qué hacemos: la tarjeta entera es el enlace -->
  <section class="section bg-surface" aria-labelledby="que-hacemos">
    <div class="wrap">
      <SectionHeading eyebrow="Qué hacemos" title="Todo para tu moto y tu jardín" id="que-hacemos" />
      <ul class="mt-8 grid gap-4 sm:gap-6 md:mt-10 md:grid-cols-3 lg:gap-8">
        {
          SERVICIOS.map((s) => (
            <li>
              <a href={s.href} class="group box box-hover flex h-full flex-col overflow-hidden">
                <div class="relative aspect-[16/9] overflow-hidden md:aspect-[4/3]">
                  <Picture
                    src={s.foto}
                    formats={['avif', 'webp']}
                    alt=""
                    widths={[400, 720, 960]}
                    sizes="(min-width: 1536px) 440px, (min-width: 768px) 33vw, calc(100vw - 2rem)"
                    class="h-full w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-[1.03]"
                  />
                  {/* Palabra sobre la foto, con degradado oscuro detrás. Entre md y xl, más pequeña para que
                      «JARDÍN Y FORESTAL» quepa en una línea */}
                  <div data-theme="dark" class="absolute inset-x-0 bottom-0 bg-transparent">
                    <div class="h-10 bg-gradient-to-t from-page/85 to-page/0" />
                    <h3 class="bg-gradient-to-t from-page/90 to-page/85 px-5 pb-4 text-[2.5rem] font-bold uppercase leading-none sm:px-6 md:px-4 md:text-[1.625rem] lg:px-6 lg:text-[2rem] xl:text-[2.5rem]">
                      {s.palabra}
                    </h3>
                  </div>
                </div>
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <p class="text-muted">{s.texto}</p>
                  <span class="mt-auto pt-4 font-semibold text-link">
                    <ConFlecha texto={s.enlace} class="transition-transform duration-150 motion-safe:group-hover:translate-x-1" />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Ofertas: las dos mitades con corte diagonal de la página de ofertas original, con sus fotos -->
  <section class="bg-page" aria-labelledby="ofertas">
    <h2 id="ofertas" class="sr-only">Ofertas</h2>
    <ul class="grid md:grid-cols-2">
      {
        OFERTAS.map((o, i) => (
          <li class:list={[i === 1 && 'md:-ml-14']}>
            <a
              href={o.ruta}
              data-theme="dark"
              class:list={[
                'group relative grid h-64 place-items-center overflow-hidden px-6 text-center md:h-80',
                i === 0
                  ? 'md:pr-16 md:[clip-path:polygon(0_0,100%_0,calc(100%-4rem)_100%,0_100%)]'
                  : 'md:pl-16 md:[clip-path:polygon(4rem_0,100%_0,100%_100%,0_100%)]',
              ]}
            >
              <Picture
                src={o.foto}
                formats={['avif', 'webp']}
                widths={[480, 800, 1120]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={40}
                alt=""
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-page/70 transition-colors group-hover:bg-page/60" />
              <div class="relative">
                <p class="text-[0.8125rem] font-bold uppercase tracking-[0.12em] text-fg">Ofertas</p>
                <h3 class="mt-2 text-[2.5rem] font-bold uppercase leading-none md:text-5xl">{o.titulo}</h3>
                <span class="btn btn-primary mt-5">
                  {o.n > 0 ? `Ver ${o.n} folleto${o.n === 1 ? '' : 's'}` : 'Ver ofertas'}
                  <Icon name="arrow-right" class="size-5" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 4. Marcas: las 5 destacadas (enlazan a su web) y dos carruseles con el resto -->
  <section class="section bg-page" aria-labelledby="marcas">
    <div class="wrap">
      <SectionHeading eyebrow="Marcas" title="Marcas con las que trabajamos" id="marcas" />
      {/* 2 columnas en móvil (la quinta, a lo ancho); desde sm, 3 + 2 centradas; desde lg, las 5 en fila */}
      <LogoGrid
        links
        brands={[...DESTACADAS_MOTO, ...DESTACADAS_FORESTAL]}
        class="mt-8 grid-cols-2 md:mt-10 [&>li:last-child]:col-span-2 sm:grid-cols-6 sm:[&>li]:col-span-2 sm:[&>li:nth-child(4)]:col-start-2 lg:grid-cols-5 lg:[&>li:last-child]:col-span-1 lg:[&>li:nth-child(4)]:col-start-auto lg:[&>li]:col-span-1"
      />
    </div>
    <h3 class="wrap eyebrow mb-3 mt-12 font-sans md:mt-14">Motos y recambios</h3>
    <BrandMarquee label="Marcas de motos y recambios" brands={MARCAS_MOTO} />
    <h3 class="wrap eyebrow mb-3 mt-8 font-sans">Jardín y forestal</h3>
    <BrandMarquee label="Marcas de jardín y forestal" brands={MARCAS_FORESTAL} reverse />
  </section>

  <!-- 5. Dónde estamos: el mapa de Google a todo el ancho, como en la web original -->
  <section class="section bg-surface" aria-labelledby="donde-estamos">
    <div class="wrap">
      <SectionHeading eyebrow="Visítanos" title="Dónde estamos" id="donde-estamos">
        <ContactActions slot="aside" actions={['directions']} />
      </SectionHeading>
      <Map ratio="h-[24rem] sm:h-[26rem] lg:h-[29rem]" class="mt-8 md:mt-10" />
      <Horario class="mt-8" />
    </div>
  </section>
</Layout>

<script>
  // Fotos del héroe: una cada 5 s, con fundido. La 2.ª y la 3.ª están ocultas (sin descargar) hasta que arranca, después de
  // cargar la página: así no frenan la primera. Con «reducir movimiento» empiezan paradas (el botón las pone en marcha).
  const carrusel = document.querySelector('[data-carrusel]');
  const boton = carrusel?.querySelector<HTMLButtonElement>('[data-pausa]');
  if (carrusel && boton) {
    const fotos = [...carrusel.querySelectorAll<HTMLImageElement>('img[data-foto]')];
    const [pausa, play] = boton.querySelectorAll('svg');
    let actual = 0;
    let reloj: ReturnType<typeof setInterval> | undefined;
    let tocado = false;
    const marcar = (enMarcha: boolean) => {
      boton.setAttribute('aria-label', enMarcha ? 'Pausar las fotos' : 'Reanudar las fotos');
      pausa.classList.toggle('hidden', !enMarcha);
      play.classList.toggle('hidden', enMarcha);
    };
    const arrancar = () => {
      if (reloj) return;
      fotos.forEach((f) => f.classList.remove('hidden'));
      reloj = setInterval(() => {
        const siguiente = (actual + 1) % fotos.length;
        if (!fotos[siguiente].complete) return; // aún descargando: sigue la actual hasta la próxima vuelta
        fotos[actual].classList.add('opacity-0');
        fotos[siguiente].classList.remove('opacity-0');
        actual = siguiente;
      }, 5000);
      marcar(true);
    };
    const parar = () => {
      clearInterval(reloj);
      reloj = undefined;
      marcar(false);
    };
    // Según lo que muestra el botón (antes de arrancar ya dice «Pausar»): pulsarlo también anula el arranque automático
    boton.addEventListener('click', () => {
      tocado = true;
      if (play.classList.contains('hidden')) parar();
      else arrancar();
    });
    // Arranca 2 s después de cargar la página: las otras fotos no compiten con nada
    const enDosSegundos = () => setTimeout(() => tocado || arrancar(), 2000);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) marcar(false);
    else if (document.readyState === 'complete') enDosSegundos();
    else addEventListener('load', enDosSegundos, { once: true });
  }
</script>

<style>
  /* Fotos del héroe fundidas con el fondo oscuro, sin corte duro. Móvil y tablet: por abajo, hacia el texto.
     Desde lg: en diagonal por la izquierda (como el corte de la web original: más a la derecha arriba que abajo) y un
     poco por abajo. Medidas fijas: opaco en los primeros 6rem (tapa el borde de la caja, que pisa el final de la columna
     de texto) y transparente a los 16rem, en cualquier pantalla. */
  .hero-fundido {
    background: linear-gradient(to top, rgb(var(--c-page)) 0, rgb(var(--c-page) / 0) 3rem);
  }
  @media (min-width: 1024px) {
    .hero-fundido {
      background:
        linear-gradient(100deg, rgb(var(--c-page)) 0, rgb(var(--c-page)) 6rem, rgb(var(--c-page) / 0) 16rem),
        linear-gradient(to top, rgb(var(--c-page) / 0.45) 0, rgb(var(--c-page) / 0) 6rem);
    }
  }
</style>
