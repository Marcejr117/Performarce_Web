---
// Portada: presentación, líneas de negocio, confianza, marcas y visita.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import BrandMarquee from '../components/BrandMarquee.astro';

import hero from '../assets/portada/H150-0226.jpg';
import ofertaMoto from '../assets/fondos/oferta_moto.jpeg';
import ofertaForestal from '../assets/fondos/oferta_forestal.jpg';
import carretera from '../assets/fondos/carretera.jpg';
import cesped from '../assets/fondos/cesped.png';
import escudo from '../assets/logo/escudo.png';

import macborSvg from '../assets/marcas/moto/macbor.svg';
import symTexto from '../assets/marcas/moto/sym_texto.png';
import husqvarnaTexto from '../assets/marcas/forestal/husqvarna_logo_texto.png';
import benzaBlack from '../assets/marcas/forestal/benza_black.png';
import zanon from '../assets/marcas/forestal/zanon.png';

import { PHONE, PHONE_LABEL, WHATSAPP, EMAIL, MAPS } from '../data/business';

// Logos de los carruseles: fichero -> nombre de la marca (alt)
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/marcas/{moto,forestal}/*.{png,jpg,jpeg}', {
  eager: true,
});
const brands = (cat: 'moto' | 'forestal', list: [string, string][]) =>
  list.map(([file, name]) => ({ name, logo: logos[`../assets/marcas/${cat}/${file}`].default }));

const motoBrands = brands('moto', [
  ['Arrow_Logo.jpg', 'Arrow'],
  ['barikit-logo.png', 'Barikit'],
  ['Dellorto_logo.jpg', "Dell'Orto"],
  ['elf-logo.png', 'Elf'],
  ['euromoto.jpg', 'Euromoto'],
  ['macbor.png', 'Macbor'],
  ['italkit.png', 'Italkit'],
  ['logo_ng.png', 'NG'],
  ['logo_shad.jpg', 'Shad'],
  ['logo-gro.jpg', 'GRO'],
  ['logo-jjuan.png', 'J.Juan'],
  ['logo-polini.png', 'Polini'],
  ['logo-rainers.png', 'Rainers'],
  ['logo-shiro.jpg', 'Shiro'],
  ['malossi_logo.png', 'Malossi'],
  ['MT_Helmets.jpg', 'MT Helmets'],
  ['NGK_logo.png', 'NGK'],
  ['nzi.jpg', 'NZI'],
  ['rq.png', 'RQ'],
  ['sym.jpg', 'SYM'],
  ['TJT_logo.png', 'TJT'],
  ['tk.png', 'TK'],
  ['vicma.jpg', 'Vicma'],
]);

const forestalBrands = brands('forestal', [
  ['Benza.jpg', 'Benza'],
  ['biss_stratton.png', 'Briggs & Stratton'],
  ['Echo_logo.jpg', 'Echo'],
  ['Honda_logo.png', 'Honda'],
  ['husqvarna_Logo.png', 'Husqvarna'],
  ['MTD.png', 'MTD'],
  ['oleomac-logo.png', 'Oleo-Mac'],
  ['oregon.png', 'Oregon'],
  ['Snapper.jpg', 'Snapper'],
]);

const featured = [
  { name: 'Macbor', href: 'https://www.macbor.com/', logo: macborSvg },
  { name: 'SYM', href: 'https://www.sym.com.es/', logo: symTexto },
  { name: 'Husqvarna', href: 'https://www.husqvarna.com/es/', logo: husqvarnaTexto },
  { name: 'Benza', href: 'https://benza.es/', logo: benzaBlack },
  { name: 'Zanon', href: 'https://www.zanon.it/en/', logo: zanon },
];

const lines = [
  {
    href: '/ofertas_moto',
    title: 'Motos y complementos',
    text: 'Motos, scooters y ciclomotores nuevos y de ocasión, cascos, accesorios y recambios. Reparación y mantenimiento en nuestro taller.',
    image: ofertaMoto,
    alt: 'Rueda de una moto de cross levantando tierra',
  },
  {
    href: '/ofertas_forestal',
    title: 'Jardinería y forestal',
    text: 'Cortacéspedes, robots, motosierras, desbrozadoras y maquinaria forestal. Venta, reparación y puesta a punto.',
    image: ofertaForestal,
    alt: 'Troncos apilados junto a un camino en el bosque',
  },
];

const trust = [
  { title: '+40 años', text: 'Más de cuatro décadas atendiendo a clientes de Albacete y alrededores.' },
  { title: 'Taller propio', text: 'Reparamos y revisamos motos, scooters y maquinaria de jardín y forestal.' },
  { title: 'Recambios', text: 'Repuestos y consumibles para que tu máquina vuelva a funcionar cuanto antes.' },
  { title: 'Primeras marcas', text: 'Trabajamos con Macbor, SYM, Husqvarna, Benza y Zanon, entre otras.' },
];
---

<Layout
  title="Taller de motos, jardín y forestal en Albacete"
  description="Talleres Marcelino: más de 40 años reparando y vendiendo motos, scooters y maquinaria de jardinería y forestal en Albacete. Recambios y taller propio."
>
  <!-- Portada: texto + foto con el corte diagonal (firma de la marca) -->
  <section class="bg-paper-200 dark:bg-ink-800 md:grid md:min-h-[32rem] md:grid-cols-2">
    <div class="flex flex-col justify-center px-4 py-12 md:px-12 lg:px-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-700 dark:text-brand-400">
        Talleres Marcelino · Albacete
      </p>
      <h1 class="mt-2 text-4xl leading-none text-ink dark:text-paper md:text-5xl lg:text-6xl">
        Taller y tienda de motos, jardín y forestal en Albacete
      </h1>
      <p class="mt-4 max-w-prose text-lg text-neutral-700 dark:text-neutral-300">
        Más de 40 años reparando y vendiendo motos, scooters y maquinaria de jardinería y forestal. Recambios, taller
        propio y trato cercano.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`tel:${PHONE}`} class="btn btn-primary">Llamar al {PHONE_LABEL}</a>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span>
        </a>
        <a href={MAPS} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          Cómo llegar<span class="sr-only"> (abre Google Maps en una pestaña nueva)</span>
        </a>
      </div>
    </div>
    <div class="relative aspect-[16/9] md:clip-diagonal-l md:aspect-auto">
      <Image
        src={hero}
        alt="Operario con equipo de protección talando un árbol con motosierra"
        widths={[640, 960, 1470]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[30%_50%]"
      />
    </div>
  </section>

  <!-- Líneas de negocio -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="lineas">
    <h2 id="lineas" class="text-3xl text-ink dark:text-paper md:text-4xl">Qué hacemos</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        lines.map((l) => (
          <a
            href={l.href}
            class="group flex flex-col overflow-hidden rounded-xl bg-paper-200 ring-1 ring-paper-300 transition hover:ring-brand-500 focus-visible:outline focus-visible:outline-4 focus-visible:outline-brand-500 dark:bg-ink-800 dark:ring-ink-700"
          >
            <Image
              src={l.image}
              alt={l.alt}
              widths={[480, 800]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-[16/10] w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-2xl text-ink dark:text-paper">{l.title}</h3>
              <p class="mt-2 flex-1 text-neutral-700 dark:text-neutral-300">{l.text}</p>
              <span class="mt-4 font-semibold text-brand-700 group-hover:underline dark:text-brand-400">
                Ver ofertas <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Confianza -->
  <section class="bg-ink text-paper dark:border-y dark:border-ink-700 dark:bg-ink-800" aria-labelledby="confianza">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-[auto_1fr]">
      <Image src={escudo} alt="" width={160} class="mx-auto h-auto w-32 md:w-40" />
      <div>
        <h2 id="confianza" class="text-3xl md:text-4xl">Por qué venir a vernos</h2>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            trust.map((t) => (
              <li class="border-l-4 border-brand-500 pl-4">
                <h3 class="text-2xl text-brand-400">{t.title}</h3>
                <p class="mt-1 text-neutral-300">{t.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Marcas destacadas -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="destacadas">
    <h2 id="destacadas" class="text-3xl text-ink dark:text-paper md:text-4xl">Marcas destacadas</h2>
    <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 [&>li:last-child]:col-span-2 sm:[&>li:last-child]:col-span-1">
      {
        featured.map((f) => (
          <li>
            <a
              href={f.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-24 items-center justify-center rounded-xl bg-white p-4 ring-1 ring-paper-300 transition hover:ring-brand-500 focus-visible:outline focus-visible:outline-4 focus-visible:outline-brand-500 dark:ring-ink-700"
            >
              <Image src={f.logo} alt={`${f.name} (web oficial, abre en una pestaña nueva)`} height={112} class="h-14 w-auto max-w-full object-contain" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Carruseles de marcas -->
  <section aria-labelledby="marcas">
    <h2 id="marcas" class="sr-only">Marcas con las que trabajamos</h2>
    <BrandMarquee title="Motos" brands={motoBrands} background={carretera} reverse duration={70} />
    <BrandMarquee title="Forestal" brands={forestalBrands} background={cesped} duration={35} />
  </section>

  <!-- Visita y contacto (sin horario hasta que lo facilite el dueño) -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="visita">
    <div class="grid gap-8 rounded-xl bg-paper-200 p-8 dark:bg-ink-800 md:grid-cols-2 md:items-center">
      <div>
        <h2 id="visita" class="text-3xl text-ink dark:text-paper md:text-4xl">Ven a vernos</h2>
        <address class="mt-4 space-y-1 not-italic text-neutral-700 dark:text-neutral-300">
          <p class="font-semibold text-ink dark:text-paper">Talleres Marcelino</p>
          <p>Av. los Toreros, 22, 02005 Albacete</p>
          <p>Teléfono: <a href={`tel:${PHONE}`} class="font-semibold text-brand-700 hover:underline dark:text-brand-400">{PHONE_LABEL}</a></p>
          <p>Correo: <a href={`mailto:${EMAIL}`} class="font-semibold text-brand-700 hover:underline dark:text-brand-400">{EMAIL}</a></p>
        </address>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={MAPS} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Cómo llegar<span class="sr-only"> (abre Google Maps en una pestaña nueva)</span>
        </a>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Escríbenos por WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span>
        </a>
        <a href="/contact" class="btn btn-ghost">Formulario de contacto</a>
      </div>
    </div>
  </section>
</Layout>
