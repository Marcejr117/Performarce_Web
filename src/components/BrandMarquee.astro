---
// Carrusel infinito de logos: un único bucle CSS sobre una pista con la lista y su copia (aria-hidden).
// Se pausa con el ratón o el foco y, con «reducir movimiento», queda quieto como rejilla.
import { Image } from 'astro:assets';
import type { Brand } from '../data/marcas';

interface Props {
  brands: Brand[];
  /** Nombre accesible de la banda (aria-label). */
  label: string;
  /** Sentido contrario. */
  reverse?: boolean;
  /** Segundos por vuelta. */
  duration?: number;
}

const { brands, label, reverse = false, duration = 70 } = Astro.props;
// Con pocas marcas, la lista se repite para que una vuelta sea más ancha que la pantalla (si no, quedaría un hueco)
const reps = Math.max(1, Math.ceil(20 / brands.length));
const items = Array.from({ length: reps }, (_, r) => brands.map((b) => ({ ...b, dup: r > 0 }))).flat();
---

<div
  data-marquee
  class="marquee bg-surface py-6 focus-visible:-outline-offset-[3px]"
  tabindex="0"
  role="region"
  aria-label={label}
>
  <div class:list={['track', { reverse }]} style={`--duration:${duration}s`}>
    {
      [false, true].map((copy) => (
        <ul class:list={['list', { copy }]} aria-hidden={copy ? 'true' : undefined}>
          {items.map((b) => (
            <li
              class="mx-2 flex h-24 flex-none items-center rounded-xl border border-line bg-logo-tile px-5"
              data-dup={b.dup ? '' : undefined}
              aria-hidden={!copy && b.dup ? 'true' : undefined}
            >
              <Image
                src={b.logo}
                alt={copy || b.dup ? '' : b.name}
                height={112}
                class="h-14 w-auto max-w-[10rem] object-contain mix-blend-multiply"
              />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<script>
  // Los logos son diferidos, pero Chrome no vuelve a mirarlos mientras la animación CSS los mueve dentro de la banda
  // (overflow: hidden) y alguna ficha cruzaba vacía varios segundos. Al acercarse la banda a la pantalla se cargan
  // todos; al abrir la página quedan lejos y no compiten con la foto principal.
  const io = new IntersectionObserver(
    (entradas) =>
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
        io.unobserve(e.target);
      }),
    { rootMargin: '600px 0px' },
  );
  document.querySelectorAll('[data-marquee]').forEach((m) => io.observe(m));
</script>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, black 4rem, black calc(100% - 4rem), transparent 100%);
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee var(--duration) linear infinite;
  }
  .track.reverse { animation-direction: reverse; }
  .marquee:hover .track,
  .marquee:focus-within .track { animation-play-state: paused; }
  .list { display: flex; flex-shrink: 0; align-items: center; }
  /* La pista lleva la lista dos veces: moverla la mitad da un bucle sin saltos */
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  /* Con «reducir movimiento»: sin animación ni copias, y los logos en varias filas */
  @media (prefers-reduced-motion: reduce) {
    .marquee { mask-image: none; }
    .track { width: auto; }
    .list { flex-shrink: 1; width: 100%; flex-wrap: wrap; justify-content: center; row-gap: 1rem; }
    .copy, [data-dup] { display: none; }
  }
</style>
