---
// Banda oscura de cierre (en los dos temas) con los botones de Llamar y WhatsApp.
import type { ComponentProps } from 'astro/types';
import ContactActions from './ContactActions.astro';

type Botones = ComponentProps<typeof ContactActions>;
interface Props {
  title?: string;
  text?: string;
  /** Mensaje ya escrito para WhatsApp. */
  whatsappText?: string;
  /** Botones y botón relleno, como en ContactActions (por defecto Llamar, relleno, y WhatsApp). */
  actions?: Botones['actions'];
  primary?: Botones['primary'];
}

const {
  title = '¿Hablamos?',
  text = 'Llámanos o escríbenos por WhatsApp y te atendemos.',
  whatsappText,
  actions,
  primary,
} = Astro.props;
---

<section data-theme="dark" class="bg-surface">
  <div class="wrap flex flex-col gap-6 py-12 md:py-16 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
    <div>
      <h2>{title}</h2>
      <p class="lead mt-3">{text}</p>
    </div>
    <ContactActions actions={actions} primary={primary} whatsappText={whatsappText} full class="flex-none" />
  </div>
</section>
