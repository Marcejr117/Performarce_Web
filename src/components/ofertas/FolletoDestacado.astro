---
// Un solo folleto: tarjeta apaisada con la carátula a la izquierda y textos y botones a la derecha (en el móvil, los
// botones debajo, a todo el ancho). Unos 330 px de alto en escritorio; antes, con la carátula en una caja enorme,
// unos 460, y 750 en el móvil. El id permite enlazarlo (#ancla), como las tarjetas.
import Icon from '../Icon.astro';
import Caratula from './Caratula.astro';
import BotonCompartir from './BotonCompartir.astro';
import { meta, waFolleto } from './folleto';
import { CATEGORIAS, type Folleto } from '../../lib/ofertas';

interface Props {
  folleto: Folleto;
  eager?: boolean;
}

const { folleto: f, eager = true } = Astro.props;
// Una carátula apaisada va en una caja apaisada y más ancha, para que no quede pequeña
const apaisado = !!f.portada && f.portada.width > f.portada.height;
---

<article
  id={f.id}
  class:list={[
    'box grid max-w-5xl items-center gap-x-4 gap-y-5 p-4 target:ring-2 target:ring-brand target:ring-offset-2 target:ring-offset-page sm:gap-x-8 sm:p-6',
    apaisado
      ? 'grid-cols-[8.5rem_1fr] sm:grid-cols-[16rem_1fr]'
      : 'grid-cols-[6.5rem_1fr] sm:grid-cols-[11rem_1fr] lg:grid-cols-[13rem_1fr]',
  ]}
>
  {/* La carátula repite «Ver folleto»: fuera del teclado y de los lectores de pantalla */}
  <a
    href={f.href}
    target="_blank"
    rel="noopener noreferrer"
    type="application/pdf"
    aria-hidden="true"
    tabindex="-1"
    class:list={[
      'group grid place-items-center rounded-lg bg-surface p-2 sm:row-span-2 sm:p-4',
      apaisado ? 'aspect-[4/3]' : 'aspect-[3/4]',
    ]}
  >
    <Caratula folleto={f} ratio={apaisado ? 4 / 3 : 3 / 4} eager={eager} sizes="(min-width: 640px) 16rem, 8.5rem" />
  </a>
  {/* min-w-0 y overflow-wrap: un nombre de PDF sin espacios («OfertasPrimavera2026») se parte en vez de desbordar */}
  <div class="min-w-0 sm:self-end">
    <p class="eyebrow">{CATEGORIAS[f.categoria].nombre}</p>
    <h2 class="mt-1 text-[1.5rem] [overflow-wrap:anywhere] sm:text-[2rem]">{f.titulo}</h2>
    <p class="mt-1 text-[0.9375rem] leading-normal text-muted">{meta(f)}</p>
    <p class="mt-3 max-w-measure max-sm:hidden">Si te interesa algún producto, pregúntanos por disponibilidad y precio.</p>
  </div>
  <div class="col-span-2 flex flex-wrap gap-3 sm:col-span-1 sm:col-start-2 sm:self-start">
    <a href={f.href} target="_blank" rel="noopener noreferrer" type="application/pdf" class="btn btn-primary grow sm:grow-0">
      <Icon name="external-link" class="size-5" />
      Ver folleto<span class="sr-only"> «{f.titulo}» (se abre en una pestaña nueva)</span>
    </a>
    <a href={waFolleto(f)} target="_blank" rel="noopener noreferrer" class="btn btn-outline grow sm:grow-0">
      <Icon name="brand-whatsapp" class="size-5" />
      Preguntar por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
    <div class="flex gap-3">
      <a href={f.href} download class="btn btn-ghost">
        <Icon name="download" class="size-5" />
        Descargar<span class="sr-only"> ({f.peso})</span>
      </a>
      <BotonCompartir url={f.url} titulo={f.titulo} texto />
    </div>
  </div>
</article>
