---
// Un solo folleto en la categoría: carátula grande a la izquierda y textos y botones a la derecha (a todo el ancho,
// en vez de una tarjeta suelta con dos tercios vacíos). El id permite enlazarlo (#ancla), como las tarjetas.
import Icon from '../Icon.astro';
import Caratula from './Caratula.astro';
import BotonCompartir from './BotonCompartir.astro';
import { meta, waFolleto } from './folleto';
import { CATEGORIAS, type Folleto } from '../../lib/ofertas';

interface Props {
  folleto: Folleto;
  /** h2 en la página de su categoría; h3 dentro de una sección que ya tiene su h2 (y entonces sin la categoría encima). */
  nivel?: 'h2' | 'h3';
  eager?: boolean;
}

const { folleto: f, nivel: Titulo = 'h2', eager = true } = Astro.props;
// Una carátula apaisada va en una caja apaisada y más ancha, para que no quede pequeña
const apaisado = !!f.portada && f.portada.width > f.portada.height;
---

<article
  id={f.id}
  class:list={[
    'box grid items-center gap-8 p-5 target:ring-2 target:ring-brand target:ring-offset-2 target:ring-offset-page sm:p-8 md:gap-10 lg:p-10',
    apaisado ? 'md:grid-cols-[minmax(0,30rem)_1fr]' : 'md:grid-cols-[minmax(0,22rem)_1fr]',
  ]}
>
  {/* La carátula repite «Ver folleto»: fuera del teclado y de los lectores de pantalla */}
  <a
    href={f.href}
    target="_blank"
    rel="noopener noreferrer"
    type="application/pdf"
    aria-hidden="true"
    tabindex="-1"
    class:list={[
      'group mx-auto grid w-full place-items-center rounded-lg bg-surface p-6 sm:p-8',
      apaisado ? 'aspect-[4/3] max-w-md md:max-w-none' : 'aspect-[3/4] max-w-[17rem] md:max-w-none',
    ]}
  >
    <Caratula folleto={f} ratio={apaisado ? 4 / 3 : 3 / 4} eager={eager} />
  </a>
  {/* min-w-0 y overflow-wrap: un nombre de PDF sin espacios («OfertasPrimavera2026») se parte en vez de desbordar */}
  <div class="min-w-0">
    {Titulo === 'h2' && <p class="eyebrow mb-2">{CATEGORIAS[f.categoria].nombre}</p>}
    <Titulo class:list={['[overflow-wrap:anywhere]', Titulo === 'h3' && 'text-[1.75rem] leading-tight']}>{f.titulo}</Titulo>
    <p class="mt-2 text-[0.9375rem] leading-normal text-muted">{meta(f)}</p>
    <p class="mt-4 max-w-measure">
      Ábrelo en el navegador o descárgalo. Si te interesa algún producto, pregúntanos por disponibilidad y precio.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={f.href} target="_blank" rel="noopener noreferrer" type="application/pdf" class="btn btn-primary grow sm:grow-0">
        <Icon name="external-link" class="size-5" />
        Ver folleto<span class="sr-only"> «{f.titulo}» (se abre en una pestaña nueva)</span>
      </a>
      <a href={waFolleto(f)} target="_blank" rel="noopener noreferrer" class="btn btn-outline grow sm:grow-0">
        <Icon name="brand-whatsapp" class="size-5" />
        Preguntar por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
      </a>
      <div class="flex gap-3">
        <a href={f.href} download class="btn btn-ghost">
          <Icon name="download" class="size-5" />
          Descargar<span class="sr-only"> ({f.peso})</span>
        </a>
        <BotonCompartir url={f.url} titulo={f.titulo} texto />
      </div>
    </div>
  </div>
</article>
