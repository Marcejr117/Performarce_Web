---
// Folletos de una categoría: con uno, el diseño destacado; con dos o más, la rejilla de tarjetas
// (1 columna en móvil con tarjetas horizontales, 2 desde sm, 3 desde lg, 4 desde xl y 5 desde 2xl).
import FolletoCard from './FolletoCard.astro';
import FolletoDestacado from './FolletoDestacado.astro';
import type { Folleto } from '../../lib/ofertas';

interface Props {
  folletos: Folleto[];
  /** Nivel del título del destacado: h3 si la sección ya tiene su h2. */
  nivel?: 'h2' | 'h3';
  /** Cuántas carátulas cargan sin esperar (las primeras de la página). */
  eager?: number;
  /** false: siempre tarjetas, con las columnas completas aunque haya pocas (en la página general todas las secciones
      se ven iguales y una categoría con un solo folleto no parece la oferta principal). */
  destacar?: boolean;
  class?: string;
}

const { folletos, nivel = 'h2', eager = 2, destacar = true, class: cls } = Astro.props;
const COMPLETA = 'sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5';
// Con `destacar`, nunca más columnas que folletos, para no dejar columnas vacías a la derecha (clases literales para
// que Tailwind las genere; índice = número de folletos; de 5 en adelante, la rejilla completa)
const COLUMNAS = ['', '', 'sm:grid-cols-2', 'sm:grid-cols-2 lg:grid-cols-3', 'sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'];
const columnas = destacar ? (COLUMNAS[folletos.length] ?? COMPLETA) : COMPLETA;
---

{
  folletos.length === 1 && destacar ? (
    <div class={cls}>
      <FolletoDestacado folleto={folletos[0]} nivel={nivel} eager={eager > 0} />
    </div>
  ) : (
    <ul role="list" class:list={['grid grid-cols-1 gap-4 sm:gap-6 lg:gap-8', columnas, cls]}>
      {folletos.map((f, i) => (
        <FolletoCard folleto={f} eager={i < eager} />
      ))}
    </ul>
  )
}
