---
// Folletos: con uno, el diseño destacado; con dos o más, tarjetas apaisadas en rejilla (1 columna; 2 desde lg y 3 desde
// 2xl). Siempre del mismo tamaño aunque haya pocas: estiradas a todo el ancho, la carátula quedaba perdida en una caja
// enorme.
import FolletoCard from './FolletoCard.astro';
import FolletoDestacado from './FolletoDestacado.astro';
import type { Folleto } from '../../lib/ofertas';

interface Props {
  folletos: Folleto[];
  /** Cuántas carátulas cargan sin esperar (las primeras de la página). */
  eager?: number;
  /** En la página general, cada tarjeta dice su categoría. */
  conCategoria?: boolean;
}

const { folletos, eager = 2, conCategoria = false } = Astro.props;
---

{
  folletos.length === 1 ? (
    <FolletoDestacado folleto={folletos[0]} eager={eager > 0} />
  ) : (
    <ul role="list" class="grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2 lg:gap-8 2xl:grid-cols-3">
      {folletos.map((f, i) => (
        <FolletoCard folleto={f} eager={i < eager} conCategoria={conCategoria} />
      ))}
    </ul>
  )
}
