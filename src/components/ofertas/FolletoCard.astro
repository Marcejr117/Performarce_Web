---
// Tarjeta de un folleto PDF (va dentro de un <ul>), apaisada en todos los tamaños: carátula a la izquierda; título,
// datos y «Ver folleto» a la derecha; y WhatsApp, Descargar y Compartir debajo, a todo el ancho. Con la carátula
// grande encima medía más de 500 px de alto y en un portátil no se veía entera sin bajar; así, unos 260.
// En rejilla y no en flex: la fila de arriba se queda el alto que sobre, así en dos tarjetas vecinas «Ver folleto» y
// la fila de botones quedan a la misma altura aunque una carátula sea apaisada.
// El id permite enlazarla (#ancla): el anillo naranja de `target:` la resalta.
import Icon from '../Icon.astro';
import Caratula from './Caratula.astro';
import BotonCompartir from './BotonCompartir.astro';
import { BTN_APILADO, meta, waFolleto } from './folleto';
import { CATEGORIAS, type Folleto } from '../../lib/ofertas';

interface Props {
  folleto: Folleto;
  /** Las dos primeras tarjetas de la página cargan la carátula sin esperar. */
  eager?: boolean;
  /** En la página general, la categoría encima del título. */
  conCategoria?: boolean;
}

const { folleto: f, eager = false, conCategoria = false } = Astro.props;
---

<li
  id={f.id}
  class="box grid grid-cols-[6.5rem_minmax(0,1fr)] grid-rows-[1fr_auto] overflow-hidden target:ring-2 target:ring-brand target:ring-offset-2 target:ring-offset-page sm:grid-cols-[10rem_minmax(0,1fr)]"
>
  {/* La carátula repite «Ver folleto»: fuera del teclado y de los lectores de pantalla */}
  <a
    href={f.href}
    target="_blank"
    rel="noopener noreferrer"
    type="application/pdf"
    aria-hidden="true"
    tabindex="-1"
    class="group grid place-items-center border-r border-line bg-surface p-3 sm:p-4"
  >
    <Caratula folleto={f} eager={eager} sizes="(min-width: 640px) 8rem, 5rem" />
  </a>
  <div class="flex min-w-0 flex-col p-4 sm:p-5">
    {conCategoria && <p class="eyebrow mb-1">{CATEGORIAS[f.categoria].nombre}</p>}
    {/* overflow-wrap: un nombre de PDF sin espacios se parte en vez de quedar cortado */}
    <h3 class="line-clamp-2 text-xl leading-[1.15] [overflow-wrap:anywhere]">{f.titulo}</h3>
    <p class="mt-1 text-[0.9375rem] leading-normal text-muted">{meta(f)}</p>
    <div class="mt-auto pt-4">
      <a href={f.href} target="_blank" rel="noopener noreferrer" type="application/pdf" class="btn btn-outline w-full">
        Ver folleto<span class="sr-only"> «{f.titulo}» (se abre en una pestaña nueva)</span>
        <Icon name="external-link" class="size-5" />
      </a>
    </div>
  </div>
  {/* Sin botones rellenos en las tarjetas: no llenar la página de naranja. Icono y rótulo visible en los tres, a todo
      el ancho de la tarjeta (en la columna del texto, a 360 px los rótulos quedaban a 3 px y a 320 se montaban) */}
  <div class="col-span-2 grid grid-cols-3 border-t border-line p-1">
    <a
      href={waFolleto(f)}
      target="_blank"
      rel="noopener noreferrer"
      class={BTN_APILADO}
      aria-label={`Preguntar por WhatsApp por el folleto «${f.titulo}» (se abre en una pestaña nueva)`}
    >
      <Icon name="brand-whatsapp" class="size-5" />
      WhatsApp
    </a>
    <a href={f.href} download class={BTN_APILADO} aria-label={`Descargar «${f.titulo}» (${f.peso})`}>
      <Icon name="download" class="size-5" />
      Descargar
    </a>
    <BotonCompartir url={f.url} titulo={f.titulo} />
  </div>
</li>
