---
// Mapa de Google bajo demanda: el iframe no se crea hasta que el visitante pulsa
// "Cargar mapa", así Google no pone cookies sin su permiso.
import { ADDRESS as address, MAPS as mapsUrl } from '../data/business';
const embedUrl =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3100.7480919952473!2d-1.871054325239329!3d38.99824524074934!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd665fb487f1ea51%3A0x578c1f902ab4afec!2sTalleres%20Marcelino!5e0!3m2!1ses!2ses!4v1709739348889!5m2!1ses!2ses';
---

<div class="overflow-hidden rounded-lg border border-paper-300 bg-paper-200 dark:border-ink-700 dark:bg-ink-800">
  <div data-map class="relative flex aspect-[4/3] w-full items-center justify-center sm:aspect-[16/9]">
    <div data-map-placeholder class="max-w-md px-6 text-center">
      <p class="font-display text-2xl font-bold uppercase tracking-wide">{address}</p>
      <p class="mt-3 text-sm text-neutral-700 dark:text-neutral-300">
        El mapa lo sirve Google, que puede guardar cookies en tu navegador. Solo se carga si tú lo pides.
        <a href="/privacidad#mapa" class="text-brand-700 underline underline-offset-4 dark:text-brand-400">Más información</a>.
      </p>
      <button type="button" data-map-load class="btn btn-primary mt-5">Cargar mapa</button>
    </div>
    <template data-map-template>
      <iframe
        title={`Mapa de Google: Talleres Marcelino, ${address}`}
        src={embedUrl}
        class="absolute inset-0 h-full w-full border-0"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </template>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-paper-300 px-4 py-3 dark:border-ink-700">
    <address class="not-italic">Talleres Marcelino · {address}</address>
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 underline-offset-4 hover:underline dark:text-brand-400">
      Abrir en Google Maps
    </a>
  </div>
</div>

<script>
  // Sustituye el aviso por el iframe al pulsar el botón (sirve para varios mapas por página).
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const tpl = map.querySelector<HTMLTemplateElement>('[data-map-template]');
      if (!tpl) return;
      map.querySelector('[data-map-placeholder]')?.remove();
      map.append(tpl.content.cloneNode(true));
      map.querySelector('iframe')?.focus();
    });
  });
</script>
