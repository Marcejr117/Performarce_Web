---
// Mapa interactivo de Google Maps (el mismo de la web original), visible al cargar la página.
// Es la única carga de terceros de la web (se explica en /privacidad#mapa). Igual en los dos temas.
import { ADDRESS, MAPS } from '../data/business';

interface Props {
  /** Proporción del mapa (clases aspect-*). */
  ratio?: string;
  /** Dirección en el pie del mapa; false si la página ya la muestra al lado (/location). */
  address?: boolean;
  class?: string;
}

const { ratio = 'aspect-[4/3] sm:aspect-[16/10]', address = true, class: cls } = Astro.props;
const embedUrl =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3100.7480919952473!2d-1.871054325239329!3d38.99824524074934!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd665fb487f1ea51%3A0x578c1f902ab4afec!2sTalleres%20Marcelino!5e0!3m2!1ses!2ses!4v1709739348889!5m2!1ses!2ses';
---

<figure class:list={['overflow-hidden rounded-xl border border-line bg-surface', cls]}>
  <div class:list={['relative w-full', ratio]}>
    <iframe
      src={embedUrl}
      title={`Mapa de Google Maps: Talleres Marcelino, ${ADDRESS}`}
      class="absolute inset-0 h-full w-full border-0"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <figcaption
    class="flex flex-wrap items-center justify-between gap-x-4 border-t border-line bg-raised px-4 py-1 text-[0.9375rem] lg:py-3"
  >
    {address && <address class="py-2 not-italic lg:py-0">{ADDRESS}</address>}
    <a href={MAPS} target="_blank" rel="noopener noreferrer" class="lnk inline-flex min-h-11 items-center lg:min-h-0">
      Abrir en Google Maps<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
  </figcaption>
</figure>
