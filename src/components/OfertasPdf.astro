---
// Página de ofertas de una categoría (/ofertas_moto y /ofertas_forestal). Los folletos se leen de la carpeta en
// el build: basta con subir o borrar PDF en public/ofertasPDF/<categoria>/ (app Java o GitHub).
// Con 0 folletos, invitación a preguntar; con 1, diseño destacado; con más, rejilla. Siempre lleva
// «Qué encontrarás en la tienda», para que la página nunca quede casi vacía.
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import SectionHeading from './SectionHeading.astro';
import LogoGrid from './LogoGrid.astro';
import Icon from './Icon.astro';
import FiltroCategorias from './ofertas/FiltroCategorias.astro';
import ListaFolletos from './ofertas/ListaFolletos.astro';
import OfertasVacio from './ofertas/OfertasVacio.astro';
import AyudaOfertas from './ofertas/AyudaOfertas.astro';
import { PHONE_LABEL } from '../data/business';
import { DESTACADAS_FORESTAL, DESTACADAS_MOTO, MARCAS_FORESTAL, MARCAS_MOTO } from '../data/marcas';
import { CATEGORIAS, getFolletos, type Categoria } from '../lib/ofertas';

interface Props {
  categoria: Categoria;
  /** H1 y última miga; el <title> es «{titulo} en Albacete». */
  titulo: string;
  /** «{TELEFONO}» se cambia por el teléfono de business.ts: las páginas no pueden importarlo (líneas 1–11 fijas). */
  description: string;
}

const { categoria, titulo, description } = Astro.props;
const { nombre, whatsapp } = CATEGORIAS[categoria];
const folletos = getFolletos(categoria);
const hay = folletos.length > 0;

const TIENDA = {
  moto: {
    texto:
      "En la tienda tienes motos, scooters y ciclomotores nuevos y de ocasión, cascos, accesorios y recambios. Trabajamos con Macbor y SYM, y con marcas de recambios y equipamiento como Malossi, Polini, Arrow, Dell'Orto, NGK, Shad o MT Helmets.",
    marcas: [...DESTACADAS_MOTO, ...MARCAS_MOTO],
    // Con fichas compactas en el móvil (23 logos: 6 filas de 64 px en vez de 8 de 96)
    columnas: 'grid-cols-4 lg:grid-cols-6 xl:grid-cols-8',
    enlaces: [
      { href: '/tienda-de-motos', texto: 'Motos, scooters y recambios' },
      { href: '/taller-de-motos', texto: 'Taller de motos' },
    ],
  },
  forestal: {
    texto:
      'Cortacéspedes, robots cortacésped, motosierras, desbrozadoras y maquinaria forestal de Husqvarna, Benza, Zanon, Echo, Honda u Oleo-Mac, entre otras. Venta, reparación y puesta a punto en nuestro taller.',
    marcas: [...DESTACADAS_FORESTAL, ...MARCAS_FORESTAL],
    columnas: 'grid-cols-3 sm:grid-cols-5',
    enlaces: [{ href: '/jardin-y-forestal', texto: 'Maquinaria de jardín y forestal' }],
  },
};
const tienda = TIENDA[categoria];
const otra: Categoria = categoria === 'moto' ? 'forestal' : 'moto';
---

<Layout
  title={`${titulo} en Albacete`}
  description={description.replace('{TELEFONO}', PHONE_LABEL)}
  breadcrumbs={[{ name: 'Ofertas', href: '/ofertas' }, { name: titulo }]}
>
  <PageHeader
    title={titulo}
    lead={hay ? `Folletos y promociones vigentes de ${nombre.toLowerCase()}.` : undefined}
    tone={hay ? 'surface' : 'page'}
    compacta
  >
    <FiltroCategorias actual={categoria} />
  </PageHeader>

  {
    hay ? (
      <div class="py-8 md:py-10">
        <div class="wrap">
          {/* Con un folleto, su título es el h2 del destacado; con varios, h2 oculto para no saltar de h1 a h3 */}
          {folletos.length > 1 && <h2 class="sr-only">Folletos de {nombre.toLowerCase()}</h2>}
          <ListaFolletos folletos={folletos} />
        </div>
      </div>
    ) : (
      <OfertasVacio categoria={categoria} />
    )
  }

  <section class:list={['section', hay && 'border-t border-line']} aria-labelledby="tienda">
    <div class="wrap">
      <SectionHeading id="tienda" title="Qué encontrarás en la tienda" lead={tienda.texto}>
        <ul slot="aside" role="list" class="flex flex-col">
          {
            tienda.enlaces.map((e) => (
              <li>
                <a href={e.href} class="lnk inline-flex min-h-11 items-center gap-2">
                  {e.texto}
                  <Icon name="arrow-right" class="size-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </SectionHeading>
      <LogoGrid compacta brands={tienda.marcas} class={`mt-8 md:mt-10 ${tienda.columnas}`} />
    </div>
  </section>

  {hay && <AyudaOfertas whatsappText={whatsapp} otra={otra} />}
</Layout>
