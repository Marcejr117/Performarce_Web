---
// Cabecera fija, siempre oscura, con las pestañas de la web original: Inicio, Información, Ubicación, Contacto y
// Ofertas, la última y en naranja, como en la original. Desde lg, en la barra; por debajo, en el menú. Llamar va en
// la portada y, en móvil, en la barra fija.
import { Image } from 'astro:assets';
import escudo from '../assets/logo/escudo.png';
import Icon from './Icon.astro';
import ContactActions from './ContactActions.astro';
import { BUSINESS } from '../data/business';

// Enlace activo: 'page' si coincide exacta; 'true' si coincide por prefijo (Ofertas también en /ofertas_moto…)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) =>
  path === href ? ('page' as const) : href !== '/' && path.startsWith(href) ? ('true' as const) : undefined;

const NAV = [
  { href: '/', label: 'Inicio' },
  { href: '/info', label: 'Información' },
  { href: '/location', label: 'Ubicación' },
  { href: '/contact', label: 'Contacto' },
].map((l) => ({ ...l, current: current(l.href) }));
const OFERTAS = { href: '/ofertas', label: 'Ofertas', current: current('/ofertas') };
const MENU = [...NAV, OFERTAS];
---

<header data-theme="dark" class="sticky top-0 z-50 border-b border-line bg-page/95 backdrop-blur">
  {/* Desde lg, tres columnas: escudo a la izquierda, pestañas en el centro y Ofertas y tema a la derecha */}
  <div class="wrap flex h-16 items-center gap-2 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a href="/" class="flex flex-none items-center gap-2.5 self-stretch lg:justify-self-start" aria-label={`${BUSINESS}, inicio`}>
      <Image src={escudo} alt="" height={80} loading="eager" class="h-10 w-auto" />
      <span class="font-display text-[1.125rem] font-bold uppercase leading-none tracking-[0.01em] text-fg min-[380px]:text-[1.25rem]">
        Talleres <span class="text-brand">Marcelino</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center">
        {
          NAV.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.current}
                class:list={[
                  'relative flex h-16 items-center px-4 text-[0.9375rem] font-medium transition-colors',
                  l.current ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {l.label}
                {l.current && <span class="absolute inset-x-4 bottom-0 h-0.5 bg-brand" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
        {/* Como en la web original, Ofertas cierra las pestañas en naranja */}
        <li class="relative flex h-16 items-center pl-2">
          <a href={OFERTAS.href} aria-current={OFERTAS.current} class="btn btn-primary">
            {OFERTAS.label}
          </a>
          {OFERTAS.current && <span class="absolute bottom-0 left-2 right-0 h-0.5 bg-brand" aria-hidden="true" />}
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:col-start-3 lg:ml-0 lg:justify-self-end">
      <button type="button" data-theme-toggle class="btn btn-square btn-ghost" aria-label="Cambiar a modo oscuro">
        <Icon name="moon" class="if-root-light size-6" />
        <Icon name="sun" class="if-root-dark size-6" />
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="group btn btn-square btn-ghost lg:hidden"
        aria-controls="menu-movil"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <Icon name="menu-2" class="size-6 group-aria-expanded:hidden" />
        <Icon name="x" class="hidden size-6 group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <!-- Menú móvil (por debajo de lg): se superpone al contenido, no lo empuja -->
  <div
    id="menu-movil"
    hidden
    class="absolute inset-x-0 top-full max-h-[calc(100dvh_-_4rem)] overflow-y-auto border-b border-line bg-page shadow-card-hover lg:hidden"
  >
    <nav aria-label="Menú móvil" class="wrap pb-6 pt-2">
      <ul class="divide-y divide-line">
        {
          MENU.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.current}
                class:list={[
                  'flex min-h-12 items-center gap-3 text-lg',
                  l === OFERTAS ? 'font-semibold text-brand' : l.current ? 'font-semibold text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                <span class:list={['h-5 w-1 rounded-full', l.current ? 'bg-brand' : 'bg-transparent']} aria-hidden="true" />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      {/* Por debajo de md ya están en la barra fija de abajo */}
      <ContactActions full class="mt-5 max-md:hidden" />
    </nav>
  </div>
</header>

<script>
  // Interruptor de tema (guarda la elección en este navegador) y menú móvil (aria-expanded, Escape y foco).
  const root = document.documentElement;
  const themeBtn = document.querySelector('[data-theme-toggle]');
  const setLabel = () =>
    themeBtn?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
  setLabel();
  themeBtn?.addEventListener('click', () => {
    const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // sin almacenamiento (modo privado): el cambio dura hasta recargar
    }
    setLabel();
  });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');
  if (toggle && menu) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean, focusButton = false) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      if (open) menu.querySelector('a')?.focus();
      else if (focusButton) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false, true);
    });
    // Un toque fuera de la cabecera también lo cierra
    document.addEventListener('click', (e) => {
      if (isOpen() && !(e.target instanceof Element && e.target.closest('header'))) setOpen(false);
    });
    // Desde lg la navegación ya está en la cabecera
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }
</script>
