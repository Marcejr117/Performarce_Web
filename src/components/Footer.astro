---
// Pie común, siempre oscuro: marca y redes, servicios, datos de visita y enlaces de la empresa.
import { Image } from 'astro:assets';
import escudo from '../assets/logo/escudo.png';
import Icon from './Icon.astro';
import Horario from './Horario.astro';
import {
  BUSINESS, PHONE, PHONE_LABEL, WHATSAPP_LABEL, EMAIL, ADDRESS, MAPS, DIRECTIONS, SOCIAL, waLink,
} from '../data/business';

const year = new Date().getFullYear();
const NUEVA = ' (se abre en una pestaña nueva)';
// Zonas táctiles de 44 px por debajo de lg; en escritorio, más juntas
const item = 'inline-flex min-h-11 items-center gap-2.5 text-muted transition-colors hover:text-fg hover:underline underline-offset-4 lg:min-h-0 lg:py-1';
const titulo = 'text-lg tracking-[0.04em] text-link';

const SERVICIOS = [
  { href: '/taller-de-motos', label: 'Taller de motos' },
  { href: '/tienda-de-motos', label: 'Motos, scooters y recambios' },
  { href: '/jardin-y-forestal', label: 'Maquinaria de jardín y forestal' },
  { href: '/ofertas_moto', label: 'Ofertas de motos y scooters' },
  { href: '/ofertas_forestal', label: 'Ofertas de jardín y forestal' },
];
const EMPRESA = [
  { href: '/info', label: 'Información' },
  { href: '/contact', label: 'Contacto' },
  { href: '/location', label: 'Ubicación' },
  { href: '/privacidad', label: 'Política de privacidad' },
];
const REDES = [
  { href: SOCIAL.facebook, icon: 'brand-facebook', label: 'Facebook' },
  { href: SOCIAL.youtube, icon: 'brand-youtube', label: 'YouTube' },
  { href: waLink(), icon: 'brand-whatsapp', label: 'WhatsApp' },
] as const;
---

<footer data-theme="dark" class="border-t-4 border-brand bg-page text-[0.9375rem]">
  <div class="wrap grid gap-x-8 gap-y-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-flex items-center gap-3" aria-label={`${BUSINESS}, inicio`}>
        <Image src={escudo} alt="" height={160} class="h-20 w-auto" />
        <span class="font-display text-2xl font-bold uppercase leading-none text-fg">
          Talleres <span class="text-brand">Marcelino</span>
        </span>
      </a>
      <p class="mt-4 max-w-xs text-muted">
        Taller y tienda de motos, jardín y forestal en Albacete desde hace más de 40 años.
      </p>
      <ul class="mt-5 flex gap-2">
        {
          REDES.map((r) => (
            <li>
              <a
                href={r.href}
                target="_blank"
                rel="noopener noreferrer"
                class="ico-chip transition-colors hover:bg-raised"
                aria-label={`${r.label}${NUEVA}`}
              >
                <Icon name={r.icon} class="size-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class={titulo}>Servicios</h2>
      <ul class="mt-3">
        {SERVICIOS.map((l) => <li><a href={l.href} class={item}>{l.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class={titulo}>Visítanos</h2>
      <ul class="mt-3">
        <li>
          <a href="/location" class={item}><Icon name="map-pin" label="Dirección:" class="size-5 text-link" />{ADDRESS}</a>
        </li>
        <li>
          <a href={`tel:${PHONE}`} class={item}><Icon name="phone" label="Teléfono:" class="size-5 text-link" />{PHONE_LABEL}</a>
        </li>
        <li>
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class={item}>
            <Icon name="brand-whatsapp" label="WhatsApp:" class="size-5 text-link" />{WHATSAPP_LABEL}<span class="sr-only">{NUEVA}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${EMAIL}`} class={item}><Icon name="mail" label="Email:" class="size-5 text-link" />{EMAIL}</a>
        </li>
      </ul>
      <Horario compact class="mt-4" />
      <ul class="mt-3">
        <li>
          <a href={DIRECTIONS.google} target="_blank" rel="noopener noreferrer" class={item}>
            {/* «Ruta en Google Maps»: el enlace a /location de la última columna se llama «Ubicación» */}
            <Icon name="route" class="size-5 text-link" />Ruta en Google Maps<span class="sr-only">{NUEVA}</span>
          </a>
        </li>
        <li>
          <a href={MAPS} target="_blank" rel="noopener noreferrer" class={item}>
            <Icon name="external-link" class="size-5 text-link" />Opiniones en Google<span class="sr-only">{NUEVA}</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class={titulo}>{BUSINESS}</h2>
      <ul class="mt-3">
        {EMPRESA.map((l) => <li><a href={l.href} class={item}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <p class="wrap py-5 text-sm text-muted">
      © {year} {BUSINESS} · performarce.com es la web oficial de {BUSINESS}
    </p>
  </div>
</footer>
